        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700&display=swap');\n\n#mora-page {\n  --mora-clay: #A84F37;\n  --mora-terracotta: #C76D4D;\n  --mora-olive: #29372D;\n  --mora-espresso: #30201B;\n  --mora-stone: #B7A48E;\n  --mora-parchment: #E7D8C0;\n  --mora-brass: #AA8243;\n  --mora-candle: #F2E7D4;\n  font-family: 'Manrope', sans-serif;\n  background: var(--mora-parchment);\n  color: var(--mora-espresso);\n  scroll-behavior: smooth;\n}\n#mora-page .mora-serif { font-family: 'DM Serif Display', Georgia, serif; }\n#mora-page .mora-sans { font-family: 'Manrope', sans-serif; }\n#mora-page .mora-kicker { letter-spacing: .2em; font-size: 10px; line-height: 1.2; font-weight: 700; text-transform: uppercase; }\n#mora-page .mora-nav { transition: background-color .35s ease, color .35s ease; }\n#mora-page .mora-nav.is-scrolled { background: var(--mora-olive); color: var(--mora-candle); }\n#mora-page .mora-nav-line { transition: border-color .35s ease; }\n#mora-page .mora-nav.is-scrolled .mora-nav-line { border-color: rgba(242,231,212,.2); }\n#mora-page .mora-primary,\n#mora-page .mora-light-button,\n#mora-page .mora-outline-button,\n#mora-page .mora-text-action,\n#mora-page .mora-nav-link,\n#mora-page .mora-menu-button,\n#mora-page .mora-gallery-item,\n#mora-page .mora-social-item,\n#mora-page .mora-food-row,\n#mora-page .mora-occasion-row { transition: background-color .25s ease, border-color .25s ease, color .25s ease, opacity .25s ease, transform .25s ease; }\n#mora-page .mora-primary { background: var(--mora-clay); color: var(--mora-espresso); }\n#mora-page .mora-primary:hover { background: var(--mora-espresso); color: var(--mora-candle); }\n#mora-page .mora-outline-button:hover { background: var(--mora-espresso); color: var(--mora-candle); }\n#mora-page .mora-light-button:hover { background: var(--mora-clay); border-color: var(--mora-clay); color: var(--mora-candle); }\n#mora-page .mora-text-action { display: inline-flex; align-items: center; gap: 12px; border-bottom: 1px solid currentColor; padding-bottom: 7px; }\n#mora-page .mora-text-action i { transition: transform .25s ease; }\n#mora-page .mora-text-action:hover i { transform: translate(4px,-4px); }\n#mora-page .mora-text-action:hover { color: var(--mora-clay); }\n#mora-page .mora-nav-link { position: relative; }\n#mora-page .mora-nav-link:after { content: ''; position: absolute; bottom: -7px; left: 0; height: 1px; width: 0; background: currentColor; transition: width .25s ease; }\n#mora-page .mora-nav-link:hover:after,\n#mora-page .mora-nav-link:focus-visible:after { width: 100%; }\n#mora-page .mora-fold { position: relative; overflow: hidden; }\n#mora-page .mora-fold:after { content: ''; position: absolute; right: 0; bottom: 0; width: 0; height: 0; border-style: solid; border-width: 0 0 27px 27px; border-color: transparent transparent var(--mora-parchment) transparent; pointer-events: none; }\n#mora-page .mora-fold-candle:after { border-color: transparent transparent var(--mora-candle) transparent; }\n#mora-page .mora-fold-clay:after { border-color: transparent transparent var(--mora-clay) transparent; }\n#mora-page .mora-hero-image { animation: mora-hero-drift 24s ease-in-out infinite alternate; filter: brightness(.72) saturate(.82); }\n#mora-page .mora-hero-shade { background: rgba(28, 16, 12, .28); }\n#mora-page .mora-hero-title { font-family: 'Manrope', sans-serif; font-weight: 500; letter-spacing: .075em; }\n#mora-page .mora-hero-cta { background: var(--mora-candle); color: var(--mora-espresso); transition: background-color .25s ease, color .25s ease, transform .25s ease; }\n#mora-page .mora-hero-cta:hover { background: var(--mora-clay); color: var(--mora-candle); transform: translateY(-2px); }\n#mora-page .mora-hero-cta i { transition: transform .25s ease; }\n#mora-page .mora-hero-cta:hover i { transform: translateY(3px); }\n#mora-page .mora-reveal { opacity: 0; transform: translateY(20px); }\n#mora-page .mora-reveal.is-visible { animation: mora-reveal-up .7s cubic-bezier(.22,.8,.28,1) forwards; animation-delay: var(--mora-delay, 0ms); }\n#mora-page .mora-reveal-mask { overflow: hidden; }\n#mora-page .mora-reveal-mask > span { display: block; transform: translateY(105%); }\n#mora-page .mora-reveal-mask.is-visible > span { animation: mora-line-up .7s cubic-bezier(.22,.8,.28,1) forwards; animation-delay: var(--mora-delay, 0ms); }\n#mora-page .mora-photo-frame { border: 1px solid var(--mora-espresso); background: var(--mora-stone); }\n#mora-page .mora-photo-frame img,\n#mora-page .mora-gallery-item img,\n#mora-page .mora-social-item img { transition: transform .45s cubic-bezier(.22,.8,.28,1), filter .3s ease; }\n#mora-page .mora-photo-frame:hover img,\n#mora-page .mora-gallery-item:hover img,\n#mora-page .mora-gallery-item:focus-visible img,\n#mora-page .mora-social-item:hover img,\n#mora-page .mora-social-item:focus-visible img { transform: scale(1.02); }\n#mora-page .mora-food-row { border-top: 1px solid rgba(242,231,212,.35); text-align: left; }\n#mora-page .mora-food-row:last-child { border-bottom: 1px solid rgba(242,231,212,.35); }\n#mora-page .mora-food-row:hover,\n#mora-page .mora-food-row.is-active { color: var(--mora-candle); }\n#mora-page .mora-food-row.is-active .mora-food-number { color: var(--mora-brass); }\n#mora-page .mora-food-row.is-active .mora-food-rule { background: var(--mora-brass); }\n#mora-page .mora-food-rule { transition: background-color .25s ease; }\n#mora-page .mora-image-changing { opacity: .18; }\n#mora-page .mora-bar-line { stroke: var(--mora-espresso); stroke-width: 1.1; fill: none; opacity: .42; }\n#mora-page .mora-gallery-scroller { scrollbar-width: none; }\n#mora-page .mora-gallery-scroller::-webkit-scrollbar { display: none; }\n#mora-page .mora-gallery-item { position: relative; overflow: hidden; text-align: left; }\n#mora-page .mora-gallery-item:focus-visible,\n#mora-page .mora-social-item:focus-visible { outline: 2px solid var(--mora-brass); outline-offset: 4px; }\n#mora-page .mora-gallery:hover .mora-gallery-item:not(:hover) img { filter: saturate(.72); }\n#mora-page .mora-gallery-item:hover .mora-gallery-caption,\n#mora-page .mora-gallery-item:focus-visible .mora-gallery-caption { color: var(--mora-clay); }\n#mora-page .mora-gallery-caption { transition: color .25s ease; }\n#mora-page .mora-occasion-row { border-top: 1px solid rgba(48,32,27,.42); text-align: left; }\n#mora-page .mora-occasion-row:last-child { border-bottom: 1px solid rgba(48,32,27,.42); }\n#mora-page .mora-occasion-row:hover,\n#mora-page .mora-occasion-row.is-active { color: var(--mora-clay); }\n#mora-page .mora-occasion-row.is-active .mora-occasion-time { color: var(--mora-clay); }\n#mora-page .mora-occasion-row.is-active .mora-occasion-marker { transform: scaleX(1); }\n#mora-page .mora-occasion-marker { transform: scaleX(0); transform-origin: left; transition: transform .25s ease; }\n#mora-page .mora-social-item { position: relative; overflow: hidden; border: 1px solid var(--mora-espresso); background: var(--mora-stone); }\n#mora-page .mora-social-item .mora-social-caption { opacity: 0; transition: opacity .25s ease; }\n#mora-page .mora-social-item:hover .mora-social-caption,\n#mora-page .mora-social-item:focus-visible .mora-social-caption { opacity: 1; }\n#mora-page .mora-map-panel { background-color: var(--mora-stone); }\n#mora-page .mora-drawer,\n#mora-page .mora-scrim,\n#mora-page .mora-mobile-menu,\n#mora-page .mora-reserve-dock { transition: transform .35s cubic-bezier(.22,.8,.28,1), opacity .3s ease, background-color .3s ease; }\n#mora-page .mora-drawer { transform: translateX(105%); }\n#mora-page .mora-drawer.is-open { transform: translateX(0); }\n#mora-page .mora-scrim { opacity: 0; pointer-events: none; }\n#mora-page .mora-scrim.is-open { opacity: 1; pointer-events: auto; }\n#mora-page .mora-mobile-menu { opacity: 0; pointer-events: none; transform: translateY(-16px); }\n#mora-page .mora-mobile-menu.is-open { opacity: 1; pointer-events: auto; transform: translateY(0); }\n#mora-page .mora-reserve-dock { transform: translateY(120%); }\n#mora-page .mora-reserve-dock.is-visible { transform: translateY(0); }\nbody.mora-lock { overflow: hidden; }\n#mora-page .mora-loading-rule { width: 0; }\n#mora-page .mora-loading-rule.is-loading { animation: mora-load-rule 1s ease-in-out infinite alternate; }\n#mora-page .mora-input { border: 1px solid rgba(242,231,212,.38); background: transparent; color: var(--mora-candle); border-radius: 2px; }\n#mora-page .mora-input:focus { border-color: var(--mora-terracotta); outline: 2px solid var(--mora-terracotta); outline-offset: 2px; }\n#mora-page .mora-input option { background: var(--mora-olive); color: var(--mora-candle); }\n#mora-page .mora-lightbox-image { max-height: 78vh; max-width: min(78vw, 1040px); object-fit: contain; }\n#mora-page .mora-menu-link { transition: color .25s ease, border-color .25s ease; }\n#mora-page .mora-menu-link:hover { color: var(--mora-terracotta); border-color: var(--mora-terracotta); }\n@keyframes mora-hero-drift { from { transform: scale(1.03) translate3d(0,0,0); } to { transform: scale(1.09) translate3d(-1.2%, -1%, 0); } }\n@keyframes mora-reveal-up { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }\n@keyframes mora-line-up { from { transform: translateY(105%); } to { transform: translateY(0); } }\n@keyframes mora-load-rule { from { width: 12%; } to { width: 100%; } }\n@media (max-width: 767px) {\n  #mora-page .mora-hero-image { object-position: 58% center; }\n  #mora-page .mora-hero-shade { background: var(--mora-espresso); opacity: .38; }\n  #mora-page .mora-drawer { transform: translateY(105%); }\n  #mora-page .mora-drawer.is-open { transform: translateY(0); }\n  #mora-page .mora-lightbox-image { max-height: 70vh; max-width: 90vw; }\n  #mora-page .mora-social-item .mora-social-caption { opacity: 1; }\n}\n@media (prefers-reduced-motion: reduce) {\n  #mora-page { scroll-behavior: auto; }\n  #mora-page .mora-hero-image { animation: none; }\n  #mora-page .mora-reveal { opacity: 1; transform: none; }\n  #mora-page .mora-reveal-mask > span { transform: none; }\n  #mora-page .mora-reveal-mask.is-visible > span { animation: none; }\n  #mora-page .mora-reveal.is-visible { animation: none; }\n  #mora-page .mora-photo-frame img,\n  #mora-page .mora-gallery-item img,\n  #mora-page .mora-social-item img { transition: none; }\n}\n</style>\n<link data-kid=\"1\" data-name=\"Google Fonts stylesheet\" href=\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css\" rel=\"stylesheet\"/>\n<div class=\"mora-sans overflow-x-clip bg-[var(--mora-parchment)] text-[var(--mora-espresso)]\" data-kid=\"2\" data-name=\"main page container\" id=\"mora-page\">\n    <header aria-label=\"Primary navigation\" class=\"mora-nav fixed inset-x-0 top-0 z-50 text-[var(--mora-candle)]\" data-kid=\"2-1\" data-name=\"primary navigation header\" id=\"mora-nav\">\n        <div class=\"mora-nav-line relative mx-auto flex h-[92px] max-w-[1440px] items-center justify-between border-b border-[var(--mora-candle)]/25 px-5 sm:px-8 lg:px-10\" data-kid=\"2-1-1\" data-name=\"navigation bar layout container\">\n            <nav aria-label=\"Main links\" class=\"hidden items-center gap-9 lg:flex\" data-kid=\"2-1-1-1\" data-name=\"reference style left navigation links\">\n                <a class=\"mora-nav-link text-[10px] font-semibold uppercase tracking-[.14em]\" data-kid=\"2-1-1-1-1\" data-name=\"locations link\" href=\"#contact\">\n                    Locations\n                </a>\n                <a class=\"mora-nav-link text-[10px] font-semibold uppercase tracking-[.14em]\" data-kid=\"2-1-1-1-2\" data-name=\"about link\" href=\"#story\">\n                    About\n                </a>\n                <a class=\"mora-nav-link text-[10px] font-semibold uppercase tracking-[.14em]\" data-kid=\"2-1-1-1-3\" data-name=\"jobs link\" href=\"#contact\">\n                    Jobs\n                </a>\n                <a class=\"mora-nav-link text-[10px] font-semibold uppercase tracking-[.14em]\" data-kid=\"2-1-1-1-4\" data-name=\"gift cards link\" href=\"#contact\">\n                    Gift cards\n                </a>\n            </nav>\n            <a aria-label=\"CHOUSE home\" class=\"absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4\" data-kid=\"2-1-1-2\" data-name=\"centered CHOUSE wordmark\" href=\"#home\">\n                <span class=\"block border-y border-[var(--mora-candle)]/80 px-2 py-2 text-[1.85rem] font-medium leading-none tracking-[.08em]\" data-kid=\"2-1-1-2-1\" data-name=\"brand name text\">\n                    CHOUSE\n                </span>\n            </a>\n            <div class=\"ml-auto flex items-center gap-4\" data-kid=\"2-1-1-3\" data-name=\"utility buttons container\">\n                <button class=\"hidden border-b border-[var(--mora-candle)]/70 pb-1 text-[10px] font-semibold uppercase tracking-[.14em] focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4 lg:inline-flex\" data-kid=\"2-1-1-3-1\" data-name=\"reserve text action\" data-open-reservation=\"\" type=\"button\">\n                    Reserve\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right ml-3 text-sm\" data-kid=\"2-1-1-3-1-1\" data-name=\"arrow-up-right icon\">\n                    </i>\n                </button>\n                <button aria-controls=\"mobile-menu\" aria-expanded=\"false\" aria-label=\"Open menu\" class=\"mora-menu-button inline-flex h-11 w-11 items-center justify-center rounded-full border border-[var(--mora-candle)]/55 text-xl focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4 lg:hidden\" data-kid=\"2-1-1-3-2\" data-name=\"mobile menu toggle button\" id=\"mobile-menu-button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-menu-2\" data-kid=\"2-1-1-3-2-1\" data-name=\"menu hamburger icon\">\n                    </i>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"2-2\" data-name=\"main content area\">\n        <section aria-labelledby=\"hero-heading\" class=\"relative flex min-h-[100svh] items-center justify-center overflow-hidden bg-[var(--mora-espresso)] text-[var(--mora-candle)] lg:min-h-screen\" data-kid=\"2-2-1\" data-name=\"hero section with animated image background\" id=\"home\">\n            <div class=\"absolute inset-0\" data-kid=\"2-2-1-1\" data-name=\"hero image background container\">\n                <img alt=\"Close cinematic view of silky milk being poured into a dark ceramic coffee cup, Thuyen Ngo on Unsplash\" class=\"mora-hero-image h-full w-full object-cover object-center\" data-dynamic=\"true\" data-kid=\"2-2-1-1-1\" data-name=\"hero background image\" data-reason=\"image source/styles updated by CSS animation and filter\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1612718114521-752ffb4dcc25?auto=format&w=2200&q=80&fit=crop\"/>\n                <div class=\"absolute inset-0 bg-[rgba(22,12,9,.22)]\" data-kid=\"2-2-1-1-2\" data-name=\"hero image color overlay\">\n                </div>\n                <div class=\"mora-hero-shade absolute inset-0\" data-kid=\"2-2-1-1-3\" data-name=\"hero image shade overlay\">\n                </div>\n            </div>\n            <div class=\"relative z-10 flex min-h-[100svh] w-full max-w-[1600px] flex-col items-center justify-center px-5 pb-28 pt-32 text-center sm:px-8 lg:min-h-screen\" data-kid=\"2-2-1-2\" data-name=\"hero content wrapper\">\n                <div class=\"mora-reveal mb-6 text-[var(--mora-candle)]/75\" data-kid=\"2-2-1-2-1\" data-name=\"hero kicker container\" data-reveal=\"\" style=\"--mora-delay:100ms\">\n                    <span class=\"mora-kicker\" data-kid=\"2-2-1-2-1-1\" data-name=\"hero kicker\">\n                        Independent Italian bistro · bar · lounge\n                    </span>\n                </div>\n                <h1 class=\"mora-hero-title mora-reveal max-w-[1200px] text-[clamp(3.2rem,10vw,9.75rem)] leading-[.84] text-[var(--mora-candle)]\" data-kid=\"2-2-1-2-2\" data-name=\"hero headline text\" data-reveal=\"\" id=\"hero-heading\" style=\"--mora-delay:180ms\">\n                    CONSIDERED\n                    <br class=\"hidden sm:block\" data-kid=\"2-2-1-2-2-1\" data-name=\"headline line break\"/>\n                    TABLES\n                </h1>\n                <p class=\"mora-reveal mt-7 max-w-[38ch] text-[11px] uppercase tracking-[.16em] text-[var(--mora-candle)]/72 sm:text-xs\" data-kid=\"2-2-1-2-3\" data-name=\"hero supporting line\" data-reveal=\"\" style=\"--mora-delay:300ms\">\n                    Good food, great drinks, and a reason to stay longer than planned.\n                </p>\n                <button aria-label=\"Wander in and reserve a table at CHOUSE\" class=\"mora-hero-cta mora-reveal mt-10 inline-flex items-center rounded-full px-7 py-3.5 text-[11px] font-semibold uppercase tracking-[.12em] focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4\" data-kid=\"2-2-1-2-4\" data-name=\"hero wander in button\" data-open-reservation=\"\" id=\"hero-reserve\" style=\"--mora-delay:420ms\" type=\"button\">\n                    Wander in\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-down ml-3 text-base\" data-kid=\"2-2-1-2-4-1\" data-name=\"down arrow icon\">\n                    </i>\n                </button>\n                <div class=\"absolute inset-x-5 bottom-6 flex flex-col items-center justify-between gap-3 border-t border-[var(--mora-candle)]/35 pt-4 text-[9px] font-semibold uppercase tracking-[.18em] text-[var(--mora-candle)]/72 sm:inset-x-8 sm:flex-row lg:inset-x-10\" data-kid=\"2-2-1-2-5\" data-name=\"hero reference style information strip\">\n                    <span data-kid=\"2-2-1-2-5-1\" data-name=\"hero brand location\">\n                        CHOUSE · Jebel Ali, Dubai\n                    </span>\n                    <span data-kid=\"2-2-1-2-5-2\" data-name=\"hero hours\">\n                        Open daily · 12:00–01:00\n                    </span>\n                    <a class=\"focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4\" data-kid=\"2-2-1-2-5-3\" data-name=\"hero phone link\" href=\"tel:+971522185569\">\n                        +971 52 218 5569\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"story-heading\" class=\"bg-[var(--mora-parchment)] px-5 py-24 sm:px-8 lg:px-10 lg:py-40\" data-kid=\"2-2-2\" data-name=\"story section\" id=\"story\">\n            <div class=\"mx-auto max-w-[1360px]\" data-kid=\"2-2-2-1\" data-name=\"story container\">\n                <div class=\"grid gap-12 lg:grid-cols-12 lg:gap-6\" data-kid=\"2-2-2-1-1\" data-name=\"story text grid\">\n                    <div class=\"mora-reveal lg:col-span-2 lg:pt-3\" data-kid=\"2-2-2-1-1-1\" data-name=\"story kicker container\" data-reveal=\"\">\n                        <p class=\"mora-kicker text-[var(--mora-clay)]\" data-kid=\"2-2-2-1-1-1-1\" data-name=\"story kicker text\">\n                            01 / The note\n                        </p>\n                        <div class=\"mt-28 hidden h-px w-full bg-[var(--mora-brass)] lg:block\" data-kid=\"2-2-2-1-1-1-2\" data-name=\"separator line\">\n                        </div>\n                    </div>\n                    <h2 class=\"mora-serif mora-reveal max-w-[690px] text-[clamp(3rem,5.8vw,5.75rem)] leading-[.93] tracking-[-.04em] lg:col-span-6\" data-kid=\"2-2-2-1-1-2\" data-name=\"story heading\" data-reveal=\"\" id=\"story-heading\" style=\"--mora-delay:100ms\">\n                        The sort of table that becomes the evening.\n                    </h2>\n                    <div class=\"mora-reveal max-w-[370px] text-sm leading-7 lg:col-span-4 lg:col-start-9 lg:pt-2\" data-kid=\"2-2-2-1-1-3\" data-name=\"story description container\" data-reveal=\"\" style=\"--mora-delay:180ms\">\n                        <p data-kid=\"2-2-2-1-1-3-1\" data-name=\"story paragraph 1\">\n                            CHOUSE is built around generous plates, considered drinks and the easy kind of hospitality that makes one course turn into three.\n                        </p>\n                        <p class=\"mt-6 text-[var(--mora-espresso)]/65\" data-kid=\"2-2-2-1-1-3-2\" data-name=\"story paragraph 2\">\n                            Come in for lunch, meet over aperitivo, or settle into dinner without watching the clock.\n                        </p>\n                    </div>\n                </div>\n                <div class=\"relative mt-16 grid gap-5 sm:mt-24 lg:mt-32 lg:grid-cols-12 lg:gap-4\" data-kid=\"2-2-2-1-2\" data-name=\"story image grid\">\n                    <figure class=\"mora-photo-frame mora-reveal relative h-[470px] lg:col-span-7 lg:col-start-2 lg:h-[650px]\" data-kid=\"2-2-2-1-2-1\" data-name=\"primary story image frame\" data-reveal=\"\" style=\"--mora-delay:100ms\">\n                        <img alt=\"Hands sharing plates around a warm restaurant table, Barnaby on Unsplash\" class=\"h-full w-full object-cover\" data-kid=\"2-2-2-1-2-1-1\" data-name=\"story image 1\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1746102821841-ea2f6341c214?auto=format&w=1000&q=80&fit=crop\"/>\n                        <figcaption class=\"absolute bottom-0 left-0 bg-[var(--mora-clay)] px-4 py-3 text-[10px] font-semibold uppercase tracking-[.14em] text-[var(--mora-candle)]\" data-kid=\"2-2-2-1-2-1-2\" data-name=\"primary image caption\">\n                            Good food, good drinks, no rush.\n                        </figcaption>\n                    </figure>\n                    <figure class=\"mora-photo-frame mora-reveal relative h-[250px] lg:absolute lg:bottom-[-70px] lg:left-[56%] lg:col-span-4 lg:h-[310px]\" data-kid=\"2-2-2-1-2-2\" data-name=\"secondary story image frame\" data-reveal=\"\" style=\"--mora-delay:240ms\">\n                        <img alt=\"Hands preparing shared food at a restaurant table, Filipp Romanovski on Unsplash\" class=\"h-full w-full object-cover\" data-kid=\"2-2-2-1-2-2-1\" data-name=\"story image 2\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1661587781420-dc427db4ccda?auto=format&w=700&q=80&fit=crop\"/>\n                        <figcaption class=\"absolute bottom-3 left-3 bg-[var(--mora-parchment)] px-3 py-2 text-[10px] uppercase tracking-[.12em] text-[var(--mora-espresso)]\" data-kid=\"2-2-2-1-2-2-2\" data-name=\"secondary image caption\">\n                            A place to linger\n                        </figcaption>\n                    </figure>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"food-heading\" class=\"border-y border-[var(--mora-espresso)]/10 bg-[var(--mora-clay)] px-5 py-24 text-[var(--mora-candle)] sm:px-8 lg:px-10 lg:py-36\" data-kid=\"2-2-3\" data-name=\"food menu section\" id=\"food\">\n            <div class=\"mx-auto grid max-w-[1360px] gap-12 lg:grid-cols-[.9fr_1.1fr] lg:gap-16\" data-kid=\"2-2-3-1\" data-name=\"food menu container\">\n                <figure aria-live=\"polite\" class=\"order-first relative h-[min(126vw,620px)] overflow-hidden border border-[var(--mora-espresso)] bg-[var(--mora-espresso)] lg:order-last lg:mt-20 lg:h-[710px]\" data-kid=\"2-2-3-1-1\" data-name=\"food display stage\" id=\"food-stage\">\n                    <img alt=\"Handmade pasta twirled on a white ceramic plate with tomato and parmesan, Erwan Hesry on Unsplash\" class=\"h-full w-full object-cover\" data-dynamic=\"true\" data-kid=\"2-2-3-1-1-1