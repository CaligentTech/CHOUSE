      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Manrope:wght@400;500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n:root {\n  --clay: #A64E35;\n  --tomato: #C86443;\n  --forest: #243B2D;\n  --espresso: #2A1C18;\n  --cream: #E9DDC6;\n  --stone: #CBB9A0;\n  --brass: #A88343;\n  --night: #18271E;\n  --ink-soft: #5B4439;\n}\n\n.ch-shell {\n  font-family: 'Manrope', sans-serif;\n  background: var(--cream);\n  color: var(--espresso);\n  font-variant-numeric: lining-nums;\n}\n\n.ch-shell ::selection {\n  background: var(--brass);\n  color: var(--espresso);\n}\n\n.font-display { font-family: 'DM Serif Display', serif; }\n\n.site-header {\n  color: var(--cream);\n  border-color: rgba(233, 221, 198, .32);\n}\n\n.site-header.is-scrolled {\n  color: var(--espresso);\n  background: var(--cream);\n  border-color: var(--stone);\n}\n\n.site-header.menu-open {\n  color: var(--cream);\n  background: var(--night);\n  border-color: rgba(233, 221, 198, .18);\n}\n\n.header-muted { color: rgba(233, 221, 198, .68); }\n.site-header.is-scrolled .header-muted { color: var(--ink-soft); }\n.site-header.menu-open .header-muted { color: rgba(233, 221, 198, .68); }\n\n.plate-frame {\n  position: relative;\n  overflow: hidden;\n  background: var(--clay);\n}\n\n.plate-frame::after {\n  content: '';\n  position: absolute;\n  right: -22px;\n  bottom: -24px;\n  width: 142px;\n  height: 66px;\n  background: var(--frame-cut, var(--cream));\n  border-radius: 58% 0 0 0;\n  transform: rotate(-11deg);\n  pointer-events: none;\n}\n\n.plate-frame-small::after {\n  width: 98px;\n  height: 46px;\n  right: -18px;\n  bottom: -17px;\n}\n\n.crop-hover { overflow: hidden; }\n.crop-image {\n  transform: scale(1.001);\n  transition: transform 900ms cubic-bezier(.2,.7,.2,1), filter 900ms cubic-bezier(.2,.7,.2,1);\n}\n.crop-hover:hover .crop-image,\n.crop-hover:focus-within .crop-image {\n  transform: scale(1.045);\n  filter: saturate(1.06) contrast(1.02);\n}\n\n.thread-line {\n  position: relative;\n  height: 1px;\n  background: var(--brass);\n}\n\n.thread-line::before,\n.thread-line::after {\n  content: '';\n  position: absolute;\n  top: -3px;\n  width: 7px;\n  height: 7px;\n  border: 1px solid var(--brass);\n  border-radius: 999px;\n  background: currentColor;\n}\n.thread-line::before { left: 0; }\n.thread-line::after { right: 0; }\n\n.text-action {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  gap: .6rem;\n}\n.text-action::after {\n  content: '';\n  position: absolute;\n  left: 0;\n  right: 1.4rem;\n  bottom: -.45rem;\n  height: 1px;\n  background: currentColor;\n  transform-origin: left;\n}\n.text-action:hover { color: var(--brass); }\n.text-action:hover::after { transform: scaleX(.72); }\n\n.reserve-button {\n  transition: background-color 220ms ease, border-color 220ms ease, color 220ms ease;\n}\n.reserve-button:hover {\n  background: var(--brass);\n  border-color: var(--brass);\n  color: var(--espresso);\n}\n\n.hero-media { will-change: transform, filter; }\n\n.hero-rail {\n  writing-mode: vertical-rl;\n  transform: rotate(180deg);\n}\n\n.open-ring {\n  position: relative;\n}\n.open-ring::before {\n  content: '';\n  position: absolute;\n  inset: -9px;\n  border: 1px solid rgba(168, 131, 67, .72);\n  border-left-color: transparent;\n  border-radius: 999px;\n  transform: rotate(28deg);\n}\n\n.bar-act {\n  position: relative;\n  overflow: clip;\n}\n.bar-act::before {\n  content: '';\n  position: absolute;\n  top: 18%;\n  right: 0;\n  width: 44%;\n  height: 1px;\n  background: rgba(168, 131, 67, .65);\n}\n.bar-act::after {\n  content: '';\n  position: absolute;\n  right: 18%;\n  top: 18%;\n  width: 1px;\n  height: 72%;\n  background: rgba(168, 131, 67, .55);\n}\n\n.atmosphere-grid {\n  display: grid;\n  grid-template-columns: 1.25fr .72fr .9fr .42fr;\n  grid-template-rows: 178px 178px 128px;\n  gap: 9px;\n}\n.atmo-main { grid-column: 1 / 3; grid-row: 1 / 3; }\n.atmo-drink { grid-column: 3; grid-row: 1 / 3; }\n.atmo-detail { grid-column: 4; grid-row: 1; }\n.atmo-room { grid-column: 4; grid-row: 2; }\n.atmo-wide { grid-column: 1 / 4; grid-row: 3; }\n\n.gallery-button {\n  position: relative;\n  display: block;\n  overflow: hidden;\n  width: 100%;\n  height: 100%;\n  text-align: left;\n  background: var(--espresso);\n}\n.gallery-button::after {\n  content: '';\n  position: absolute;\n  inset: auto 0 0;\n  height: 36%;\n  background: rgba(42, 28, 24, .38);\n  pointer-events: none;\n}\n.gallery-caption {\n  position: absolute;\n  right: 13px;\n  bottom: 11px;\n  left: 13px;\n  z-index: 1;\n  color: var(--cream);\n  font-size: 10px;\n  font-weight: 700;\n  letter-spacing: .16em;\n  line-height: 1.4;\n  text-transform: uppercase;\n}\n.gallery-button .crop-image { height: 100%; width: 100%; object-fit: cover; }\n\n.occasion-board { position: relative; }\n.occasion-list { padding-right: 218px; }\n.occasion-row {\n  position: relative;\n  min-height: 83px;\n  border-top: 1px solid rgba(233, 221, 198, .55);\n  color: var(--cream);\n  text-align: left;\n}\n.occasion-row:last-child { border-bottom: 1px solid rgba(233, 221, 198, .55); }\n.occasion-row::before {\n  content: '';\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 0;\n  height: 1px;\n  background: var(--cream);\n  transition: width 260ms ease;\n}\n.occasion-row:hover::before,\n.occasion-row:focus-visible::before,\n.occasion-row.is-active::before { width: 64px; }\n.occasion-row:hover .occasion-arrow,\n.occasion-row:focus-visible .occasion-arrow,\n.occasion-row.is-active .occasion-arrow { color: var(--cream); transform: translate(3px, -3px); }\n.occasion-arrow { transition: color 220ms ease, transform 220ms ease; }\n.occasion-preview {\n  position: absolute;\n  top: 0;\n  right: 0;\n  width: 190px;\n  height: 132px;\n  background: var(--espresso);\n}\n.occasion-preview img { height: 100%; width: 100%; object-fit: cover; }\n.occasion-preview::after {\n  content: '';\n  position: absolute;\n  right: -14px;\n  bottom: -17px;\n  width: 78px;\n  height: 38px;\n  background: var(--clay);\n  border-radius: 58% 0 0 0;\n  transform: rotate(-11deg);\n}\n.occasion-preview-caption {\n  position: absolute;\n  right: 9px;\n  bottom: 7px;\n  left: 9px;\n  z-index: 1;\n  color: var(--cream);\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: .12em;\n  text-transform: uppercase;\n  text-shadow: 0 1px 8px rgba(42,28,24,.7);\n}\n\n.social-grid {\n  display: grid;\n  grid-template-columns: 1fr 1.05fr 1.05fr .95fr .55fr;\n  grid-template-rows: 170px 170px 112px;\n  gap: 9px;\n}\n.social-a { grid-column: 1; grid-row: 1 / 4; }\n.social-b { grid-column: 2 / 4; grid-row: 1 / 3; }\n.social-c { grid-column: 4 / 6; grid-row: 1; }\n.social-d { grid-column: 4 / 6; grid-row: 2; }\n.social-e { grid-column: 2; grid-row: 3; }\n.social-f { grid-column: 3; grid-row: 3; }\n.social-g { grid-column: 4; grid-row: 3; }\n.social-tile { grid-column: 5; grid-row: 3; }\n.social-grid .gallery-button { background: var(--clay); }\n.social-grid .gallery-button::after { height: 45%; background: rgba(24, 39, 30, .35); }\n\n.map-panel { position: relative; overflow: hidden; }\n.map-panel::after {\n  content: '';\n  position: absolute;\n  right: -28px;\n  bottom: -29px;\n  width: 170px;\n  height: 74px;\n  border-radius: 58% 0 0 0;\n  background: var(--stone);\n  transform: rotate(-10deg);\n  pointer-events: none;\n}\n\n.mobile-menu { display: none; }\n.mobile-menu.is-open {\n  display: flex;\n  animation: menu-in 420ms cubic-bezier(.2,.7,.2,1) both;\n}\n@keyframes menu-in {\n  from { clip-path: inset(0 0 100% 0); }\n  to { clip-path: inset(0 0 0 0); }\n}\n\n.mobile-reserve {\n  transform: translateY(110%);\n  transition: transform 260ms ease;\n}\n.mobile-reserve.is-active { transform: translateY(0); }\n\n.lightbox { display: none; }\n.lightbox.is-open { display: flex; }\n.lightbox-image { max-height: calc(100svh - 180px); }\n\n:where(a, button):focus-visible {\n  outline: 2px solid var(--brass);\n  outline-offset: 4px;\n}\n\n@media (max-width: 900px) {\n  .atmosphere-grid {\n    grid-template-columns: 1.1fr .9fr;\n    grid-template-rows: 210px 155px 155px 110px;\n  }\n  .atmo-main { grid-column: 1 / 3; grid-row: 1 / 3; }\n  .atmo-drink { grid-column: 1; grid-row: 3; }\n  .atmo-detail { grid-column: 2; grid-row: 3; }\n  .atmo-room { grid-column: 1; grid-row: 4; }\n  .atmo-wide { grid-column: 2; grid-row: 4; }\n  .social-grid {\n    grid-template-columns: 1fr 1fr;\n    grid-template-rows: 210px 145px 145px 104px 104px;\n  }\n  .social-a { grid-column: 1; grid-row: 1 / 3; }\n  .social-b { grid-column: 2; grid-row: 1 / 3; }\n  .social-c { grid-column: 1 / 3; grid-row: 3; }\n  .social-d { grid-column: 1; grid-row: 4; }\n  .social-e { grid-column: 2; grid-row: 4; }\n  .social-f { grid-column: 1; grid-row: 5; }\n  .social-g { grid-column: 2; grid-row: 5; }\n  .social-tile { display: none; }\n}\n\n@media (max-width: 640px) {\n  .plate-frame::after { width: 94px; height: 45px; right: -16px; bottom: -17px; }\n  .hero-rail { writing-mode: initial; transform: none; }\n  .occasion-list { padding-right: 0; }\n  .occasion-preview {\n    position: relative;\n    top: auto;\n    right: auto;\n    width: 100%;\n    height: 0;\n    margin-top: 0;\n    opacity: 0;\n    overflow: hidden;\n  }\n  .occasion-preview.is-mobile-visible {\n    height: 190px;\n    margin-top: 12px;\n    opacity: 1;\n  }\n  .occasion-row { min-height: 69px; }\n  .social-grid {\n    grid-template-rows: 180px 132px 132px 96px 96px;\n  }\n  .lightbox-image { max-height: calc(100svh - 240px); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .mobile-menu.is-open { animation: none; }\n  .crop-image,\n  .text-action,\n  .text-action::after,\n  .reserve-button,\n  .occasion-row::before,\n  .occasion-arrow,\n  .mobile-reserve { transition: none; }\n}\n</style>\n<div class=\"ch-shell min-h-screen overflow-x-clip bg-[var(--cream)] text-[var(--espresso)]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header aria-label=\"Primary navigation\" class=\"site-header fixed inset-x-0 top-0 z-[120] border-b px-5 py-4 md:px-8\" data-kid=\"1-1\" data-name=\"site header\" id=\"site-header\">\n        <div class=\"mx-auto flex h-8 max-w-[1320px] items-center justify-between gap-5\" data-kid=\"1-1-1\" data-name=\"header content container\">\n            <a aria-label=\"CH House home\" class=\"flex min-w-0 items-baseline gap-2 text-[13px] font-bold tracking-[.2em]\" data-kid=\"1-1-1-1\" data-name=\"site branding link\" href=\"#home\">\n                <span data-kid=\"1-1-1-1-1\" data-name=\"brand name text\">\n                    CH HOUSE\n                </span>\n                <span class=\"header-muted hidden text-[9px] font-medium tracking-[.12em] sm:inline\" data-kid=\"1-1-1-1-2\" data-name=\"brand descriptive text\">\n                    BISTRO · BAR · LOUNGE\n                </span>\n            </a>\n            <nav aria-label=\"Main menu\" class=\"hidden items-center gap-7 text-[10px] font-bold uppercase tracking-[.18em] lg:flex\" data-kid=\"1-1-1-2\" data-name=\"main navigation bar\">\n                <a class=\"hover:text-[var(--brass)]\" data-kid=\"1-1-1-2-1\" data-name=\"menu link\" href=\"#menu\">\n                    Menu\n                </a>\n                <a class=\"hover:text-[var(--brass)]\" data-kid=\"1-1-1-2-2\" data-name=\"menu link\" href=\"#about\">\n                    About\n                </a>\n                <a class=\"hover:text-[var(--brass)]\" data-kid=\"1-1-1-2-3\" data-name=\"menu link\" href=\"#bar\">\n                    Bar\n                </a>\n                <a class=\"hover:text-[var(--brass)]\" data-kid=\"1-1-1-2-4\" data-name=\"menu link\" href=\"#experience\">\n                    Experience\n                </a>\n                <a class=\"hover:text-[var(--brass)]\" data-kid=\"1-1-1-2-5\" data-name=\"menu link\" href=\"#gallery\">\n                    Gallery\n                </a>\n                <a class=\"hover:text-[var(--brass)]\" data-kid=\"1-1-1-2-6\" data-name=\"menu link\" href=\"#contact\">\n                    Contact\n                </a>\n            </nav>\n            <div class=\"flex items-center gap-2\" data-kid=\"1-1-1-3\" data-name=\"header action container\">\n                <a class=\"reserve-button rounded-[4px] border border-current px-4 py-3 text-[10px] font-bold uppercase tracking-[.17em] sm:px-5\" data-kid=\"1-1-1-3-1\" data-name=\"header reserve button\" href=\"#contact\">\n                    Reserve\n                </a>\n                <button aria-controls=\"mobile-menu\" aria-expanded=\"false\" aria-label=\"Open menu\" class=\"menu-button flex h-11 w-11 items-center justify-center lg:hidden\" data-kid=\"1-1-1-3-2\" data-name=\"mobile menu toggle button\" id=\"menu-toggle\" type=\"button\">\n                    <span aria-hidden=\"true\" class=\"flex w-5 flex-col gap-[5px]\" data-kid=\"1-1-1-3-2-1\" data-name=\"menu hamburger icon container\">\n                        <span class=\"menu-bar h-px w-full bg-current\" data-kid=\"1-1-1-3-2-1-1\" data-name=\"menu bar\">\n                        </span>\n                        <span class=\"menu-bar h-px w-full bg-current\" data-kid=\"1-1-1-3-2-1-2\" data-name=\"menu bar\">\n                        </span>\n                        <span class=\"menu-bar h-px w-full bg-current\" data-kid=\"1-1-1-3-2-1-3\" data-name=\"menu bar\">\n                        </span>\n                    </span>\n                </button>\n            </div>\n        </div>\n    </header>\n    <div aria-hidden=\"true\" aria-labelledby=\"mobile-menu-title\" aria-modal=\"true\" class=\"mobile-menu fixed inset-0 z-[110] min-h-screen flex-col bg-[var(--night)] px-6 pb-7 pt-28 text-[var(--cream)]\" data-kid=\"1-2\" data-name=\"mobile menu overlay\" id=\"mobile-menu\" role=\"dialog\">\n        <div class=\"mx-auto flex h-full w-full max-w-[1320px] flex-col\" data-kid=\"1-2-1\" data-name=\"mobile menu container\">\n            <p class=\"text-[10px] font-bold uppercase tracking-[.2em] text-[var(--stone)]\" data-kid=\"1-2-1-1\" data-name=\"mobile menu title\" id=\"mobile-menu-title\">\n                CH House / Dubai\n            </p>\n            <nav aria-label=\"Mobile menu\" class=\"mt-10 flex flex-col items-start gap-3\" data-kid=\"1-2-1-2\" data-name=\"mobile navigation links\">\n                <a class=\"font-display text-5xl leading-none\" data-kid=\"1-2-1-2-1\" data-name=\"mobile menu link\" href=\"#menu\">\n                    Menu\n                </a>\n                <a class=\"font-display text-5xl leading-none\" data-kid=\"1-2-1-2-2\" data-name=\"mobile menu link\" href=\"#about\">\n                    About\n                </a>\n                <a class=\"font-display text-5xl leading-none\" data-kid=\"1-2-1-2-3\" data-name=\"mobile menu link\" href=\"#bar\">\n                    Bar\n                </a>\n                <a class=\"font-display text-5xl leading-none\" data-kid=\"1-2-1-2-4\" data-name=\"mobile menu link\" href=\"#experience\">\n                    Experience\n                </a>\n                <a class=\"font-display text-5xl leading-none\" data-kid=\"1-2-1-2-5\" data-name=\"mobile menu link\" href=\"#gallery\">\n                    Gallery\n                </a>\n                <a class=\"font-display text-5xl leading-none\" data-kid=\"1-2-1-2-6\" data-name=\"mobile menu link\" href=\"#contact\">\n                    Contact\n                </a>\n            </nav>\n            <div class=\"mt-auto border-t border-[rgba(233,221,198,.28)] pt-5 text-xs leading-relaxed text-[var(--stone)]\" data-kid=\"1-2-1-3\" data-name=\"mobile footer info container\">\n                <p data-kid=\"1-2-1-3-1\" data-name=\"location text\">\n                    Jebel Ali · Dubai\n                </p>\n                <p data-kid=\"1-2-1-3-2\" data-name=\"opening hours text\">\n                    [Confirmed opening hours]\n                </p>\n            </div>\n            <a class=\"reserve-button mt-6 flex min-h-12 items-center justify-center rounded-[4px] border border-[var(--cream)] bg-[var(--cream)] px-5 text-[11px] font-bold uppercase tracking-[.18em] text-[var(--espresso)]\" data-kid=\"1-2-1-4\" data-name=\"mobile reserve button\" href=\"#contact\">\n                Reserve a table\n            </a>\n        </div>\n    </div>\n    <main data-kid=\"1-3\" data-name=\"main page content\">\n        <section class=\"hero-section relative min-h-[88svh] overflow-hidden bg-[var(--espresso)] text-[var(--cream)] md:min-h-[88vh]\" data-kid=\"1-3-1\" data-name=\"hero section\" id=\"home\">\n            <img alt=\"Hands and plates gathered around an Italian dinner table in warm evening light — Yaroslava Borz on Pexels\" class=\"hero-media absolute inset-0 h-full w-full object-cover object-[54%_52%]\" data-kid=\"1-3-1-1\" data-name=\"hero background image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/10439164/pexels-photo-10439164.jpeg?auto=compress&cs=tinysrgb&w=2000&q=80\"/>\n            <div class=\"absolute inset-0 bg-[rgba(42,28,24,.42)]\" data-kid=\"1-3-1-2\" data-name=\"hero overlay\">\n            </div>\n            <div class=\"absolute bottom-0 left-0 h-[38%] w-full bg-[rgba(42,28,24,.18)]\" data-kid=\"1-3-1-3\" data-name=\"hero bottom fade\">\n            </div>\n            <div class=\"absolute inset-x-0 bottom-20 hidden h-px bg-[rgba(233,221,198,.28)] lg:block\" data-kid=\"1-3-1-4\" data-name=\"hero separator line\">\n            </div>\n            <div class=\"relative z-10 mx-auto flex min-h-[88svh] max-w-[1320px] items-end px-5 pb-9 pt-28 md:min-h-[88vh] md:px-8 md:pb-14\" data-kid=\"1-3-1-5\" data-name=\"hero content wrapper\">\n                <div class=\"max-w-[820px]\" data-kid=\"1-3-1-5-1\" data-name=\"hero text container\">\n                    <p class=\"hero-kicker mb-5 text-[10px] font-bold uppercase tracking-[.22em] text-[var(--stone)] md:text-[11px]\" data-kid=\"1-3-1-5-1-1\" data-name=\"hero kicker text\">\n                        Jebel Ali · Dubai / independent Italian bistro\n                    </p>\n                    <h1 class=\"hero-title font-display max-w-[820px] text-[clamp(3.5rem,7.1vw,7.2rem)] leading-[.89] tracking-[-.025em]\" data-kid=\"1-3-1-5-1-2\" data-name=\"hero headline text\">\n                        Italian, with a life of its own.\n                    </h1>\n                    <p class=\"hero-copy mt-6 max-w-[430px] text-[15px] leading-relaxed text-[var(--cream)] md:mt-7 md:text-[18px]\" data-kid=\"1-3-1-5-1-3\" data-name=\"hero copy text\">\n                        An independent Italian bistro, bar & lounge in Dubai.\n                    </p>\n                    <div class=\"hero-actions mt-8 flex flex-wrap items-center gap-x-7 gap-y-5\" data-kid=\"1-3-1-5-1-4\" data-name=\"hero actions container\">\n                        <a class=\"reserve-button rounded-[4px] border border-[var(--cream)] bg-[var(--cream)] px-5 py-4 text-[10px] font-bold uppercase tracking-[.17em] text-[var(--espresso)] md:px-6 md:text-[11px]\" data-kid=\"1-3-1-5-1-4-1\" data-name=\"reserve button\" href=\"#contact\">\n                            Reserve a table\n                        </a>\n                        <a class=\"text-action text-[10px] font-bold uppercase tracking-[.17em] md:text-[11px]\" data-kid=\"1-3-1-5-1-4-2\" data-name=\"explore menu action\" href=\"#menu\">\n                            Explore the menu\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-base\" data-kid=\"1-3-1-5-1-4-2-1\" data-name=\"arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n                <div class=\"hero-rail ml-auto hidden items-end gap-8 pb-1 lg:flex\" data-kid=\"1-3-1-5-2\" data-name=\"hero rail container\">\n                    <div class=\"open-ring flex h-[82px] w-[82px] items-center justify-center rounded-full border border-[var(--brass)] text-center text-[9px] font-bold uppercase leading-[1.35] tracking-[.15em]\" data-kid=\"1-3-1-5-2-1\" data-name=\"open status badge\">\n                        Open\n                        <br data-kid=\"1-3-1-5-2-1-1\" data-name=\"line break\"/>\n                        status\n                    </div>\n                    <p class=\"max-w-[118px] text-[10px] font-bold uppercase leading-[1.55] tracking-[.19em] text-[var(--stone)]\" data-kid=\"1-3-1-5-2-2\" data-name=\"hero auxiliary text\">\n                        Lunch · aperitivo · dinner\n                    </p>\n                </div>\n            </div>\n            <div class=\"absolute bottom-5 left-5 right-5 z-10 flex items-center justify-between text-[9px] font-bold uppercase tracking-[.19em] text-[var(--stone)] md:left-8 md:right-8\" data-kid=\"1-3-1-6\" data-name=\"hero footer info\">\n                <span data-kid=\"1-3-1-6-1\" data-name=\"static status text\">\n                    Independent since day one\n                </span>\n                <span class=\"hidden sm:inline\" data-kid=\"1-3-1-6-2\" data-name=\"scroll down hint\">\n                    Stay a little longer\n                    <i aria-hidden=\"true\" class=\"ti ti-arrow-down text-sm\" data-kid=\"1-3-1-6-2-1\" data-name=\"down arrow icon\">\n                    </i>\n                </span>\n            </div>\n        </section>\n        <section class=\"bg-[var(--cream)] px-5 py-20 md:px-8 md:py-32\" data-kid=\"1-3-2\" data-name=\"about section\" id=\"about\">\n            <div class=\"mx-auto max-w-[1320px]\" data-kid=\"1-3-2-1\" data-name=\"about section content container\">\n                <div class=\"grid grid-cols-1 gap-12 md:grid-cols-12 md:gap-6\" data-kid=\"1-3-2-1-1\" data-name=\"about grid layout\">\n                    <p class=\"reveal-up text-[10px] font-bold uppercase tracking-[.2em] text-[var(--forest)] md:col-span-2\" data-kid=\"1-3-2-1-1-1\" data-name=\"section kicker text\">\n                        01 / The house\n                    </p>\n                    <div class=\"md:col-span-6\" data-kid=\"1-3-2-1-1-2\" data-name=\"about text container\">\n                        <h2 class=\"reveal-up font-display text-[clamp(3rem,5.1vw,5.4rem)] leading-[.93] tracking-[-.02em]\" data-kid=\"1-3-2-1-1-2-1\" data-name=\"about headline\">\n                            Come for the plate.\n                            <br data-kid=\"1-3-2-1-1-2-1-1\" data-name=\"line break\"/>\n                            <em data-kid=\"1-3-2-1-1-2-1-2\" data-name=\"headline emphasis\">\n                                Stay for the story.\n                            </em>\n                        </h2>\n                        <p class=\"reveal-up mt-8 max-w-[560px] text-[15px] leading-[1.8] text-[var(--ink-soft)] md:mt-10 md:text-[17px]\" data-kid=\"1-3-2-1-1-2-2\" data-name=\"about body text\">\n                            Good Italian food is only half the reason to gather. The other half is the second round, the extra chair pulled to the table, and a meal that is in no hurry to end. This is our independent house in Dubai: generous plates, proper drinks and a room made for staying longer than planned.\n                        </p>\n                        <a class=\"reveal-up text-action mt-8 text-[10px] font-bold uppercase tracking-[.17em]\" data-kid=\"1-3-2-1-1-2-3\" data-name=\"read story link\" href=\"#contact\">\n                            Read our story\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-right text-base\" data-kid=\"1-3-2-1-1-2-3-1\" data-name=\"arrow icon\">\n                            </i>\n                        </a>\n                        <figure class=\"reveal-up mt-12 w-[68%] md:mt-16 md:ml-[8%] md:w-[58%]\" data-kid=\"1-3-2-1-1-2-4\" data-name=\"featured image figure\">\n                            <div class=\"plate-frame plate-frame-small crop-hover aspect-square\" data-kid=\"1-3-2-1-1-2-4-1\" data-name=\"image container\" style=\"--frame-cut:var(--cream)\">\n                                <img alt=\"A hand finishing a plate of Italian pasta with grated cheese at the restaurant pass — Nadin Sh on Pexels\" class=\"crop-image h-full w-full object-cover\" data-kid=\"1-3-2-1-1-2-4-1-1\" data-name=\"featured image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/11513597/pexels-photo-11513597.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\"/>\n                            </div>\n                            <figcaption class=\"mt-3 border-t border-[var(--brass)] pt-2 text-[9px] font-bold uppercase tracking-[.16em] text-[var(--forest)]\" data-kid=\"1-3-2-1-1-2-4-2\" data-name=\"image caption\">\n                                Made to be passed around\n                            </figcaption>\n                        </figure>\n                    </div>\n                    <figure class=\"reveal-up md:col-span-4 md:mt-16\" data-kid=\"1-3-2-1-1-3\" data-name=\"secondary featured figure\">\n                        <div class=\"plate-frame crop-hover h-[440px] md:h-[590px]\" data-kid=\"1-3-2-1-1-3-1\" data-name=\"secondary image container\" style=\"--frame-cut:var(--cream)\">\n                            <img alt=\"A host finishing a plate in a warmly lit Italian restaurant — Phillip Brecht on Unsplash\" class=\"crop-image h-full w-full object-cover object-[48%_50%]\" data-kid=\"1-3-2-1-1-3-1-1\" data-name=\"secondary featured image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1685703493858-afa9b335c7b7?auto=format&w=1000&q=80&fit=crop\"/>\n                        </div>\n                        <figcaption class=\"mt-3 flex items-center justify-between border-t border-[var(--brass)] pt-2 text-[9px] font-bold uppercase tracking-[.16em] text-[var(--forest)]\" data-kid=\"1-3-2-1-1-3-2\" data-name=\"secondary image caption container\">\n                            <span data-kid=\"1-3-2-1-1-3-2-1\" data-name=\"caption text\">\n                                Service with a point of view\n                            </span>\n                            <span data-kid=\"1-3-2-1-1-3-2-2\" data-name=\"caption location\">\n                                Dubai\n                            </span>\n                        </figcaption>\n                    </figure>\n                </div>\n                <div class=\"mt-16 hidden items-center gap-5 md:flex\" data-kid=\"1-3-2-1-2\" data-name=\"divider thread container\">\n                    <div class=\"thread-line flex-1 text-[var(--cream)]\" data-kid=\"1-3-2-1-2-1\" data-name=\"thread line\">\n                    </div>\n                    <i aria-hidden=\"true\" class=\"ti ti-tools-kitchen-2 text-lg text-[var(--brass)]\" data-kid=\"1-3-2-1-2-2\" data-name=\"kitchen icon\">\n                    </i>\n                    <div class=\"thread-line w-24 text-[var(--cream)]\" data-kid=\"1-3-2-1-2-3\" data-name=\"thread line\">\n                    </div>\n                </div>\n            </div>\n        </section>\n        <section class=\"bg-[var(--stone)] px-5 py-20 md:px-8 md:py-32\" data-kid=\"1-3-3\" data-name=\"menu section\" id=\"menu\">\n            <div class=\"mx-auto max-w-[1320px]\" data-kid=\"1-3-3-1\" data-name=\"menu section content container\">\n                <div class=\"grid grid-cols-1 gap-8 md:grid-cols-12 md:gap-6\" data-kid=\"1-3-3-1-1\" data-name=\"menu header grid\">\n                    <p class=\"reveal-up text-[10px] font-bold uppercase tracking-[.2em] text-[var(--forest)] md:col-span-2\" data-kid=\"1-3-3-1-1-1\" data-name=\"section kicker\">\n                        02 / The menu\n                    </p>\n                    <h2 class=\"reveal-up font-display text-[clamp(3rem,5.1vw,5.4rem)] leading-[.93] tracking-[-.02em] md:col-span-8\" data-kid=\"1-3-3-1-1-2\" data-name=\"menu headline\">\n                        The table has a centre.\n                        <br data-kid=\"1-3-3-1-1-2-1\" data-name=\"line break\"/>\n                        <em data-kid=\"1-3-3-1-1-2-2\" data-name=\"headline emphasis\">\n                            It rarely stays there.\n                        </em>\n                    </h2>\n                    <p class=\"reveal-up self-end text-[13px] leading-[1.6] text-[var(--ink-soft)] md:col-span-2\" data-kid=\"1-3-3-1-1-3\" data-name=\"menu intro text\">\n                        Plates made for passing, ordering again and changing your mind.\n                    </p>\n                </div>\n                <div class=\"mt-14 grid grid-cols-1 gap-12 md:mt-20 md:grid-cols-12 md:items-start md:gap-4\" data-kid=\"1-3-3-1-2\" data-name=\"menu items grid\">\n                    <figure class=\"food-reveal md:col-span-2 md:mt-24\" data-kid=\"1-3-3-1-2-1\" data-name=\"menu item figure\">\n                        <div class=\"plate-frame crop-hover h-[290px] md:h-[300px]\" data-kid=\"1-3-3-1-2-1-1\" data-name=\"item image container\" style=\"--frame-cut:var(--stone)\">\n                            <img alt=\"Italian antipasti platter with olives, burrata and grilled vegetables on a terracotta table — Ahmet Koç on Unsplash\" class=\"crop-image h-full w-full object-cover\" data-kid=\"1-3-3-1-2-1-1-1\" data-name=\"menu item image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1760445530191-55f1d7a8cfd6?auto=format&w=700&q=80&fit=crop\"/>\n                        </div>\n                        <figcaption class=\"mt-4 border-t border-[var(--brass)] pt-3\" data-kid=\"1-3-3-1-2-1-2\" data-name=\"item caption container\">\n                            <span class=\"font-display text-2xl\" data-kid=\"1-3-3-1-2-1-2-1\" data-name=\"item title\">\n                                Antipasti\n                            </span>\n                            <span class=\"mt-1 block text-[9px] font-bold uppercase tracking-[.16em] text-[var(--forest)]\" data-kid=\"1-3-3-