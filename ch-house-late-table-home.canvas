id=\"2-2-8-1-1-1\" data-name=\"contact kicker text\">\n                        07 / Location\n                    </p>\n                    <h2 class=\"mora-serif mt-12 text-[clamp(3.4rem,6.6vw,6.6rem)] leading-[.88] tracking-[-.045em]\" data-kid=\"2-2-8-1-1-2\" data-name=\"contact heading\" id=\"contact-heading\">\n                        Find the long table.\n                    </h2>\n                    <div class=\"mt-14 border-y border-[var(--mora-espresso)]/28 py-7 text-sm leading-7\" data-kid=\"2-2-8-1-1-3\" data-name=\"contact details list\">\n                        <p class=\"flex items-start gap-3\" data-kid=\"2-2-8-1-1-3-1\" data-name=\"contact location\">\n                            <i aria-hidden=\"true\" class=\"ti ti-map-pin mt-1 text-base text-[var(--mora-clay)]\" data-kid=\"2-2-8-1-1-3-1-1\" data-name=\"location pin icon\">\n                            </i>\n                            <span data-kid=\"2-2-8-1-1-3-1-2\" data-name=\"location address block\">\n                                <strong class=\"font-semibold\" data-kid=\"2-2-8-1-1-3-1-2-1\" data-name=\"location company name\">\n                                    CHOUSE\n                                </strong>\n                                <br data-kid=\"2-2-8-1-1-3-1-2-2\" data-name=\"line break\"/>\n                                Jebel Ali Recreation Club\n                                <br data-kid=\"2-2-8-1-1-3-1-2-3\" data-name=\"location address lines\"/>\n                                Dubai, United Arab Emirates\n                            </span>\n                        </p>\n                        <p class=\"mt-6 flex items-start gap-3\" data-kid=\"2-2-8-1-1-3-2\" data-name=\"contact hours\">\n                            <i aria-hidden=\"true\" class=\"ti ti-clock mt-1 text-base text-[var(--mora-clay)]\" data-kid=\"2-2-8-1-1-3-2-1\" data-name=\"clock icon\">\n                            </i>\n                            <span data-kid=\"2-2-8-1-1-3-2-2\" data-name=