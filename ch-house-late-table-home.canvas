                <a class=\"mora-outline-button mt-10 inline-flex w-fit items-center border border-[var(--mora-candle)] px-6 py-4 text-[10px] font-bold uppercase tracking-[.18em] text-[var(--mora-candle)] focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4\" data-kid=\"2-2-3-1-2-4\" data-name=\"view menu full button\" href=\"#contact\">\n                        View menu\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right ml-8 text-sm\" data-kid=\"2-2-3-1-2-4-1\" data-name=\"arrow-up-right icon\">\n                        </i>\n                    </a>\n                </div>\n            </div>\n        </section>\n        <section aria-labelledby=\"bar-heading\" class=\"relative overflow-hidden bg-[var(--mora-olive)] px-5 py-28 text-[var(--mora-candle)] sm:px-8 lg:px-10 lg:py-36\" data-kid=\"2-2-4\" data-name=\"bar section\" id=\"bar\">\n            <svg aria-hidden=\"true\" class=\"pointer-events-none absolute right-[7%] top-12 hidden h-[520px] w-[420px] lg:block\" data-kid=\"2-2-4-1\" data-name=\"abstract bar SVG graphic\" viewbox=\"0 0 420 520\">\n                <path class=\"mora-bar-line\" d=\"M70 35 C150 110 260 65 316 136 C361 193 260 230 211 263 C140 311 154 381 273 420 C324 437 351 467 338 505\">\n                </path>\n                <path class=\"mora-bar-line\" d=\"M68 36 C88 55 100 68 104 94\">\n                </path>\n                <circle class=\"mora-bar-line\" cx=\"70\" cy=\"35\" r=\"5\">\n                </circle>\n            </svg>\n            <div class=\"relative mx-auto grid max-w-[1360px] gap-16 lg:grid-cols-[.9fr_1.1fr] lg:gap-20\" data-kid=\"2-2-4-2\" data-name=\"bar container\">\n                <div class=\"mora-reveal lg:pt-5\" data-kid=\"2-2-4-2-1\" data-name=\"bar image container\" data-reveal=\"\">\n                    <figure class=\"relative h-[520px] w-[88%] overflow-hidden border border-[var(--mora-espresso)] lg:h-[650px] lg:w-[86%]\" data-kid=\"2-2-4