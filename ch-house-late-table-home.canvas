                     </p>\n                    </div>\n                    <div class=\"absolute bottom-6 right-6 border border-[var(--mora-olive)]/40 bg-[var(--mora-stone)]/75 px-4 py-3 text-[9px] uppercase tracking-[.14em] text-[var(--mora-olive)]\" data-kid=\"2-2-8-1-2-4\" data-name=\"map link overlay\">\n                        Open in Maps\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right ml-2 text-sm\" data-kid=\"2-2-8-1-2-4-1\" data-name=\"arrow-up-right icon\">\n                        </i>\n                    </div>\n                </div>\n            </div>\n        </section>\n    </main>\n    <footer class=\"bg-[var(--mora-espresso)] px-5 py-20 text-[var(--mora-candle)] sm:px-8 lg:px-10 lg:py-28\" data-kid=\"2-3\" data-name=\"main page footer\">\n        <div class=\"mx-auto max-w-[1360px]\" data-kid=\"2-3-1\" data-name=\"footer wrapper\">\n            <div class=\"flex flex-col gap-12 border-b border-[var(--mora-candle)]/25 pb-16 lg:flex-row lg:items-end lg:justify-between\" data-kid=\"2-3-1-1\" data-name=\"footer header grid\">\n                <div data-kid=\"2-3-1-1-1\" data-name=\"footer brand container\">\n                    <div class=\"mora-serif text-[clamp(4.5rem,9vw,8.5rem)] leading-[.8] tracking-[-.07em]\" data-kid=\"2-3-1-1-1-1\" data-name=\"footer brand title\">\n                        CHOUSE\n                    </div>\n                    <p class=\"mt-5 text-[10px] font-semibold uppercase tracking-[.24em] text-[var(--mora-candle)]/58\" data-kid=\"2-3-1-1-1-2\" data-name=\"brand subtitle\">\n                        Italian bistro · bar · lounge\n                    </p>\n                </div>\n                <div class=\"max-w-[360px] lg:pb-1\" data-kid=\"2-3-1-1-2\" data-name=\"footer call to action container\">\n                    <p class=\"mora-serif text-3xl leading-[1.05]\" data-kid=\"2-3-1-1-2-1\" data-name=\"cta headline text\">\n                        Dinner is better when it takes its time.\n                    </p>\n                    <button class=\"mora-primary mora-fold mora-fold-candle mt-8 px-6 py-4 text-[10px] font-bold uppercase tracking-[.16em] focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4\" data-kid=\"2-3-1-1-2-2\" data-name=\"cta reserve button\" data-open-reservation=\"\" type=\"button\">\n                        Reserve a table\n                        <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right ml-6 text-sm\" data-kid=\"2-3-1-1-2-2-1\" data-name=\"arrow-up-right icon\">\n                        </i>\n                    </button>\n                </div>\n            </div>\n            <div class=\"grid gap-12 py-14 text-sm sm:grid-cols-2 lg:grid-cols-[1.3fr_.8fr_1fr]\" data-kid=\"2-3-1-2\" data-name=\"footer links grid\">\n                <div data-kid=\"2-3-1-2-1\" data-name=\"footer visit column\">\n                    <p class=\"mora-kicker text-[var(--mora-brass)]\" data-kid=\"2-3-1-2-1-1\" data-name=\"visit kicker text\">\n                        Visit\n                    </p>\n                    <div class=\"mt-5 leading-7 text-[var(--mora-candle)]/68\" data-kid=\"2-3-1-2-1-2\" data-name=\"visit content list\">\n                        <p data-kid=\"2-3-1-2-1-2-1\" data-name=\"address line 1\">\n                            Jebel Ali Recreation Club\n                        </p>\n                        <p data-kid=\"2-3-1-2-1-2-2\" data-name=\"hours line\">\n                            Daily · 12:00–01:00\n                        </p>\n                        <p data-kid=\"2-3-1-2-1-2-3\" data-name=\"location line\">\n                            Dubai, UAE\n                        </p>\n                        <a class=\"mora-menu-link mt-4 inline-block border-b border-[var(--mora-candle)]/35 pb-1 text-[11px] uppercase tracking-[.12em]\" data-kid=\"2-3-1-2-1-2-4\" data-name=\"directions link\" href=\"https://www.google.com/maps/search/?api=1&query=Jebel+Ali+Recreation+Club+Dubai\" rel=\"noreferrer\" target=\"_blank\">\n                            Directions\n                            <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right ml-1\" data-kid=\"2-3-1-2-1-2-4-1\" data-name=\"arrow-up-right icon\">\n                            </i>\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"2-3-1-2-2\" data-name=\"footer explore column\">\n                    <p class=\"mora-kicker text-[var(--mora-brass)]\" data-kid=\"2-3-1-2-2-1\" data-name=\"explore kicker text\">\n                        Explore\n                    </p>\n                    <div class=\"mt-5 grid gap-3 leading-6 text-[var(--mora-candle)]/68\" data-kid=\"2-3-1-2-2-2\" data-name=\"explore links list\">\n                        <a class=\"mora-menu-link w-fit\" data-kid=\"2-3-1-2-2-2-1\" data-name=\"menu link\" href=\"#food\">\n                            Menu\n                        </a>\n                        <a class=\"mora-menu-link w-fit\" data-kid=\"2-3-1-2-2-2-2\" data-name=\"about link\" href=\"#story\">\n                            About\n                        </a>\n                        <a class=\"mora-menu-link w-fit\" data-kid=\"2-3-1-2-2-2-3\" data-name=\"bar experience link\" href=\"#bar\">\n                            Bar experience\n                        </a>\n                        <a class=\"mora-menu-link w-fit\" data-kid=\"2-3-1-2-2-2-4\" data-name=\"gallery link\" href=\"#gallery\">\n                            Gallery\n                        </a>\n                        <a class=\"mora-menu-link w-fit\" data-kid=\"2-3-1-2-2-2-5\" data-name=\"celebrations link\" href=\"#contact\">\n                            Private celebrations\n                        </a>\n                    </div>\n                </div>\n                <div data-kid=\"2-3-1-2-3\" data-name=\"footer social column\">\n                    <p class=\"mora-kicker text-[var(--mora-brass)]\" data-kid=\"2-3-1-2-3-1\" data-name=\"social kicker text\">\n                        Keep in touch\n                    </p>\n                    <div class=\"mt-5 grid gap-3 leading-6 text-[var(--mora-candle)]/68\" data-kid=\"2-3-1-2-3-2\" data-name=\"social links list\">\n                        <a class=\"mora-menu-link w-fit\" data-kid=\"2-3-1-2-3-2-1\" data-name=\"instagram link\" href=\"https://www.instagram.com/chouseuae/\" rel=\"noreferrer\" target=\"_blank\">\n                            Instagram\n                            <i aria-hidden=\"true\" class=\"ti ti-instagram ml-1\" data-kid=\"2-3-1-2-3-2-1-1\" data-name=\"instagram icon\">\n                            </i>\n                        </a>\n                        <a class=\"mora-menu-link w-fit\" data-kid=\"2-3-1-2-3-2-2\" data-name=\"phone link\" href=\"tel:+971522185569\">\n                            +971 52 218 5569\n                        </a>\n                        <a class=\"mora-menu-link w-fit\" data-kid=\"2-3-1-2-3-2-3\" data-name=\"email link\" href=\"mailto:hello@moradubai.ae\">\n                            hello@moradubai.ae\n                        </a>\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex flex-col gap-3 border-t border-[var(--mora-candle)]/25 pt-6 text-[10px] uppercase tracking-[.14em] text-[var(--mora-candle)]/52 sm:flex-row sm:items-center sm:justify-between\" data-kid=\"2-3-1-3\" data-name=\"copyright info bar\">\n                <span data-kid=\"2-3-1-3-1\" data-name=\"copyright name\">\n                    © CHOUSE Dubai\n                </span>\n                <span data-kid=\"2-3-1-3-2\" data-name=\"reservation advice\">\n                    Reservations recommended for dinner\n                </span>\n                <span data-kid=\"2-3-1-3-3\" data-name=\"legal links\">\n                    Privacy · Accessibility\n                </span>\n            </div>\n        </div>\n    </footer>\n    <button aria-label=\"Close reservation panel\" class=\"mora-scrim fixed inset-0 z-[70] bg-[var(--mora-espresso)]/75\" data-kid=\"2-4\" data-name=\"scrim overlay for drawers\" id=\"mora-scrim\" type=\"button\">\n    </button>\n    <aside aria-hidden=\"true\" aria-labelledby=\"reservation-heading\" aria-modal=\"true\" class=\"mora-drawer fixed bottom-0 right-0 top-0 z-[75] flex w-full max-w-[520px] flex-col overflow-y-auto bg-[var(--mora-olive)] p-6 text-[var(--mora-candle)] shadow-2xl sm:p-8\" data-kid=\"2-5\" data-name=\"reservation drawer panel\" id=\"reservation-drawer\" role=\"dialog\">\n        <div class=\"flex items-start justify-between border-b border-[var(--mora-candle)]/25 pb-6\" data-kid=\"2-5-1\" data-name=\"drawer header\">\n            <div data-kid=\"2-5-1-1\" data-name=\"drawer header content\">\n                <p class=\"mora-kicker text-[var(--mora-terracotta)]\" data-kid=\"2-5-1-1-1\" data-name=\"drawer kicker\">\n                    A place at the table\n                </p>\n                <h2 class=\"mora-serif mt-5 text-5xl leading-none\" data-kid=\"2-5-1-1-2\" data-name=\"drawer title\" id=\"reservation-heading\">\n                    Reserve a table.\n                </h2>\n            </div>\n            <button aria-label=\"Close reservation panel\" class=\"inline-flex h-11 w-11 items-center justify-center border border-[var(--mora-candle)]/40 text-xl focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4\" data-kid=\"2-5-1-2\" data-name=\"close button\" id=\"close-reservation\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-x\" data-kid=\"2-5-1-2-1\" data-name=\"close icon\">\n                </i>\n            </button>\n        </div>\n        <p class=\"mt-7 max-w-[390px] text-sm leading-6 text-[var(--mora-candle)]/72\" data-kid=\"2-5-2\" data-name=\"drawer description\">\n            Tell us when you’d like to come in. We’ll confirm your table by phone or email.\n        </p>\n        <form class=\"mt-8 grid gap-5\" data-kid=\"2-5-3\" data-name=\"reservation form\" id=\"reservation-form\" novalidate=\"\">\n            <div class=\"grid grid-cols-2 gap-4\" data-kid=\"2-5-3-1\" data-name=\"guest and date row\">\n                <label class=\"grid gap-2 text-[10px] font-bold uppercase tracking-[.14em]\" data-kid=\"2-5-3-1-1\" data-name=\"guests label\">\n                    Guests\n                    <select class=\"mora-input mt-1 h-12 px-3 text-sm font-normal normal-case tracking-normal\" data-kid=\"2-5-3-1-1-1\" data-name=\"guests select\" name=\"guests\">\n                        <option data-kid=\"2-5-3-1-1-1-1\" data-name=\"option 1\">\n                            2 guests\n                        </option>\n                        <option data-kid=\"2-5-3-1-1-1-2\" data-name=\"option 2\">\n                            3 guests\n                        </option>\n                        <option data-kid=\"2-5-3-1-1-1-3\" data-name=\"option 3\">\n                            4 guests\n                        </option>\n                        <option data-kid=\"2-5-3-1-1-1-4\" data-name=\"option 4\">\n                            5 guests\n                        </option>\n                        <option data-kid=\"2-5-3-1-1-1-5\" data-name=\"option 5\">\n                            6+ guests\n                        </option>\n                    </select>\n                </label>\n                <label class=\"grid gap-2 text-[10px] font-bold uppercase tracking-[.14em]\" data-kid=\"2-5-3-1-2\" data-name=\"date label\">\n                    Date\n                    <input class=\"mora-input mt-1 h-12 px-3 text-sm font-normal normal-case tracking-normal\" data-kid=\"2-5-3-1-2-1\" data-name=\"date input\" name=\"date\" required=\"\" type=\"date\"/>\n                </label>\n            </div>\n            <label class=\"grid gap-2 text-[10px] font-bold uppercase tracking-[.14em]\" data-kid=\"2-5-3-2\" data-name=\"time select label\">\n                Preferred time\n                <select class=\"mora-input mt-1 h-12 px-3 text-sm font-normal normal-case tracking-normal\" data-kid=\"2-5-3-2-1\" data-name=\"time select\" name=\"time\">\n                    <option data-kid=\"2-5-3-2-1-1\" data-name=\"time option 1\">\n                        19:00\n                    </option>\n                    <option data-kid=\"2-5-3-2-1-2\" data-name=\"time option 2\">\n                        19:30\n                    </option>\n                    <option data-kid=\"2-5-3-2-1-3\" data-name=\"time option 3\">\n                        20:00\n                    </option>\n                    <option data-kid=\"2-5-3-2-1-4\" data-name=\"time option 4\">\n                        20:30\n                    </option>\n                    <option data-kid=\"2-5-3-2-1-5\" data-name=\"time option 5\">\n                        21:00\n                    </option>\n                    <option data-kid=\"2-5-3-2-1-6\" data-name=\"time option 6\">\n                        21:45\n                    </option>\n                </select>\n            </label>\n            <label class=\"grid gap-2 text-[10px] font-bold uppercase tracking-[.14em]\" data-kid=\"2-5-3-3\" data-name=\"name input label\">\n                Name\n                <input autocomplete=\"name\" class=\"mora-input mt-1 h-12 px-3 text-sm font-normal normal-case tracking-normal placeholder:text-[var(--mora-candle)]/42\" data-kid=\"2-5-3-3-1\" data-name=\"name input\" name=\"name\" placeholder=\"Your name\" required=\"\" type=\"text\"/>\n            </label>\n            <label class=\"grid gap-2 text-[10px] font-bold uppercase tracking-[.14em]\" data-kid=\"2-5-3-4\" data-name=\"contact input label\">\n                Mobile or email\n                <input autocomplete=\"email\" class=\"mora-input mt-1 h-12 px-3 text-sm font-normal normal-case tracking-normal placeholder:text-[var(--mora-candle)]/42\" data-kid=\"2-5-3-4-1\" data-name=\"contact input\" name=\"contact\" placeholder=\"How should we reach you?\" required=\"\" type=\"text\"/>\n            </label>\n            <button class=\"mora-primary mt-2 flex h-14 items-center justify-center rounded-[2px] px-5 text-[10px] font-bold uppercase tracking-[.16em] focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4\" data-dynamic=\"true\" data-kid=\"2-5-3-5\" data-name=\"form submit button\" data-reason=\"text and state toggled by script during check\" id=\"reservation-submit\" type=\"submit\">\n                <span data-dynamic=\"true\" data-kid=\"2-5-3-5-1\" data-name=\"button label\" data-reason=\"text updated during check\" id=\"reservation-submit-label\">\n                    Check availability\n                </span>\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right ml-5 text-sm\" data-kid=\"2-5-3-5-2\" data-name=\"arrow-up-right icon\">\n                </i>\n            </button>\n            <div aria-live=\"polite\" class=\"border-t border-[var(--mora-candle)]/25 pt-5 text-sm leading-6 text-[var(--mora-candle)]/76\" data-dynamic=\"true\" data-kid=\"2-5-3-6\" data-name=\"reservation status message\" data-reason=\"text updated by script during form submission\" id=\"reservation-status\" role=\"status\">\n                Choose a date and time to check availability.\n            </div>\n            <div class=\"hidden border-l-2 border-[var(--mora-terracotta)] pl-4 text-xs leading-5 text-[var(--mora-candle)]/72\" data-dynamic=\"true\" data-kid=\"2-5-3-7\" data-name=\"alternate times message\" data-reason=\"visibility toggled by script\" id=\"reservation-alt\">\n                That time is full. Try 19:30 or 21:45, or call us for larger tables:\n                <a class=\"border-b border-[var(--mora-candle)]/45\" data-kid=\"2-5-3-7-1\" data-name=\"alternate phone link\" href=\"tel:+971522185569\">\n                    +971 52 218 5569\n                </a>\n                .\n            </div>\n            <div class=\"hidden border-l-2 border-[var(--mora-terracotta)] pl-4 text-xs leading-5 text-[var(--mora-candle)]/72\" data-dynamic=\"true\" data-kid=\"2-5-3-8\" data-name=\"reservation error message\" data-reason=\"visibility toggled by script\" id=\"reservation-error\">\n                We couldn’t send that request. Please call +971 52 218 5569 and we’ll help.\n            </div>\n            <div aria-hidden=\"true\" class=\"mora-loading-rule h-px bg-[var(--mora-brass)]\" data-dynamic=\"true\" data-kid=\"2-5-3-9\" data-name=\"loading progress rule\" data-reason=\"animation state toggled by script\" id=\"reservation-loading-rule\">\n            </div>\n        </form>\n        <p class=\"mt-auto pt-10 text-[10px] uppercase tracking-[.14em] text-[var(--mora-candle)]/45\" data-kid=\"2-5-4\" data-name=\"footer disclaimer\">\n            Reservations recommended for dinner · open daily 12:00–01:00\n        </p>\n    </aside>\n    <div aria-hidden=\"true\" class=\"mora-mobile-menu fixed inset-0 z-[65] flex flex-col bg-[var(--mora-olive)] px-5 py-6 text-[var(--mora-candle)] sm:px-8\" data-kid=\"2-6\" data-name=\"mobile menu drawer\" id=\"mobile-menu\">\n        <div class=\"flex items-center justify-between border-b border-[var(--mora-candle)]/25 pb-5\" data-kid=\"2-6-1\" data-name=\"menu header\">\n            <a aria-label=\"CHOUSE home\" class=\"mora-serif text-[2rem] leading-none tracking-[-.05em]\" data-kid=\"2-6-1-1\" data-name=\"home link\" href=\"#home\">\n                CHOUSE\n            </a>\n            <button aria-label=\"Close menu\" class=\"inline-flex h-11 w-11 items-center justify-center border border-[var(--mora-candle)]/45 text-xl focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4\" data-kid=\"2-6-1-2\" data-name=\"close menu button\" id=\"close-mobile-menu\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-x\" data-kid=\"2-6-1-2-1\" data-name=\"close icon\">\n                </i>\n            </button>\n        </div>\n        <nav aria-label=\"Mobile links\" class=\"flex flex-col pt-16\" data-kid=\"2-6-2\" data-name=\"mobile navigation links\">\n            <a class=\"border-b border-[var(--mora-candle)]/22 py-5 text-3xl focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4\" data-kid=\"2-6-2-1\" data-name=\"menu link\" href=\"#food\">\n                Menu\n                <span class=\"float-right text-base\" data-kid=\"2-6-2-1-1\" data-name=\"index number\">\n                    01\n                </span>\n            </a>\n            <a class=\"border-b border-[var(--mora-candle)]/22 py-5 text-3xl focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4\" data-kid=\"2-6-2-2\" data-name=\"about link\" href=\"#story\">\n                About\n                <span class=\"float-right text-base\" data-kid=\"2-6-2-2-1\" data-name=\"index number\">\n                    02\n                </span>\n            </a>\n            <a class=\"border-b border-[var(--mora-candle)]/22 py-5 text-3xl focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4\" data-kid=\"2-6-2-3\" data-name=\"bar experience link\" href=\"#bar\">\n                Bar experience\n                <span class=\"float-right text-base\" data-kid=\"2-6-2-3-1\" data-name=\"index number\">\n                    03\n                </span>\n            </a>\n            <a class=\"border-b border-[var(--mora-candle)]/22 py-5 text-3xl focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4\" data-kid=\"2-6-2-4\" data-name=\"gallery link\" href=\"#gallery\">\n                Gallery\n                <span class=\"float-right text-base\" data-kid=\"2-6-2-4-1\" data-name=\"index number\">\n                    04\n                </span>\n            </a>\n            <a class=\"border-b border-[var(--mora-candle)]/22 py-5 text-3xl focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4\" data-kid=\"2-6-2-5\" data-name=\"contact link\" href=\"#contact\">\n                Contact\n                <span class=\"float-right text-base\" data-kid=\"2-6-2-5-1\" data-name=\"index number\">\n                    05\n                </span>\n            </a>\n        </nav>\n        <div class=\"mt-auto flex items-end justify-between gap-6 border-t border-[var(--mora-candle)]/25 pt-6\" data-kid=\"2-6-3\" data-name=\"menu footer\">\n            <div data-kid=\"2-6-3-1\" data-name=\"menu footer address\">\n                <p class=\"mora-kicker text-[var(--mora-terracotta)]\" data-kid=\"2-6-3-1-1\" data-name=\"menu address title\">\n                    Jebel Ali · Dubai\n                </p>\n                <p class=\"mt-3 text-xs text-[var(--mora-candle)]/65\" data-kid=\"2-6-3-1-2\" data-name=\"menu hours\">\n                    Open daily · 12:00–01:00\n                </p>\n            </div>\n            <button class=\"mora-primary px-5 py-4 text-[10px] font-bold uppercase tracking-[.14em] focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4\" data-kid=\"2-6-3-2\" data-name=\"menu reserve button\" data-open-reservation=\"\" type=\"button\">\n                Reserve\n                <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right ml-4\" data-kid=\"2-6-3-2-1\" data-name=\"arrow-up-right icon\">\n                </i>\n            </button>\n        </div>\n    </div>\n    <div aria-hidden=\"true\" aria-labelledby=\"lightbox-caption\" aria-modal=\"true\" class=\"mora-lightbox fixed inset-0 z-[90] flex items-center justify-center bg-[var(--mora-espresso)] px-5 py-6 text-[var(--mora-candle)] sm:px-10\" data-dynamic=\"true\" data-kid=\"2-7\" data-name=\"lightbox container\" data-reason=\"visible/hidden toggle state\" hidden=\"\" id=\"gallery-lightbox\" role=\"dialog\">\n        <button aria-label=\"Close gallery viewer\" class=\"absolute right-5 top-5 inline-flex h-12 w-12 items-center justify-center border border-[var(--mora-candle)]/55 text-2xl focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4\" data-kid=\"2-7-1\" data-name=\"close button\" id=\"lightbox-close\" type=\"button\">\n            <i aria-hidden=\"true\" class=\"ti ti-x\" data-kid=\"2-7-1-1\" data-name=\"close icon\">\n            </i>\n        </button>\n        <button aria-label=\"Previous gallery image\" class=\"absolute left-4 top-1/2 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center border border-[var(--mora-candle)]/45 text-2xl focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4 sm:left-8\" data-kid=\"2-7-2\" data-name=\"previous image button\" id=\"lightbox-prev\" type=\"button\">\n            <i aria-hidden=\"true\" class=\"ti ti-chevron-left\" data-kid=\"2-7-2-1\" data-name=\"chevron left icon\">\n            </i>\n        </button>\n        <div class=\"flex max-w-[1120px] flex-col items-center\" data-kid=\"2-7-3\" data-name=\"lightbox inner content\">\n            <img alt=\"Warm restaurant interior, SAAD EMRIS on Pexels\" class=\"mora-lightbox-image border border-[var(--mora-candle)]/20\" data-dynamic=\"true\" data-kid=\"2-7-3-1\" data-name=\"lightbox image\" data-reason=\"src and alt updated by interaction\" decoding=\"async\" id=\"lightbox-image\" loading=\"lazy\" src=\"https://images.pexels.com/photos/17086329/pexels-photo-17086329.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n            <div class=\"mt-5 flex w-full items-start justify-between gap-8 border-t border-[var(--mora-candle)]/25 pt-4\" data-kid=\"2-7-3-2\" data-name=\"lightbox footer info\">\n                <p class=\"text-[11px] uppercase tracking-[.15em] text-[var(--mora-candle)]/75\" data-dynamic=\"true\" data-kid=\"2-7-3-2-1\" data-name=\"lightbox caption\" data-reason=\"text updated by interaction\" id=\"lightbox-caption\">\n                    19:42 · second round\n                </p>\n                <p class=\"text-[11px] uppercase tracking-[.15em] text-[var(--mora-brass)]\" data-dynamic=\"true\" data-kid=\"2-7-3-2-2\" data-name=\"lightbox counter\" data-reason=\"text updated by interaction\" id=\"lightbox-count\">\n                    01 / 07\n                </p>\n            </div>\n        </div>\n        <button aria-label=\"Next gallery image\" class=\"absolute right-4 top-1/2 inline-flex h-12 w-12 -translate-y-1/2 items-center justify-center border border-[var(--mora-candle)]/45 text-2xl focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4 sm:right-8\" data-kid=\"2-7-4\" data-name=\"next image button\" id=\"lightbox-next\" type=\"button\">\n            <i aria-hidden=\"true\" class=\"ti ti-chevron-right\" data-kid=\"2-7-4-1\" data-name=\"chevron right icon\">\n            </i>\n        </button>\n    </div>\n    <div aria-hidden=\"true\" class=\"mora-reserve-dock fixed inset-x-4 bottom-4 z-[55] md:hidden\" data-kid=\"2-8\" data-name=\"floating reserve dock button\" id=\"reserve-dock\">\n        <button class=\"mora-fold mora-fold-candle flex w-full items-center justify-between bg-[var(--mora-clay)] px-5 py-4 text-left text-[var(--mora-espresso)] shadow-xl focus-visible:outline-2 focus-visible:outline-[var(--mora-candle)] focus-visible:outline-offset-4\" data-kid=\"2-8-1\" data-name=\"dock reserve button\" data-open-reservation=\"\" type=\"button\">\n            <span data-kid=\"2-8-1-1\" data-name=\"button text container\">\n                <span class=\"block text-[10px] font-bold uppercase tracking-[.16em]\" data-kid=\"2-8-1-1-1\" data-name=\"dock title\">\n                    A place at CHOUSE\n                </span>\n                <span class=\"mt-1 block text-xs\" data-kid=\"2-8-1-1-2\" data-name=\"dock subtitle\">\n                    Reserve a table\n                </span>\n            </span>\n            <i aria-hidden=\"true\" class=\"ti ti-arrow-up-right text-lg\" data-kid=\"2-8-1-2\" data-name=\"arrow-up-right icon\">\n            </i>\n        </button>\n    </div>\n</div>\n<script>\n    (() => {\n  const page = document.getElementById('mora-page');\n  if (!page) return;\n\n  const nav = document.getElementById('mora-nav');\n  const setNavState = () => nav.classList.toggle('is-scrolled', window.scrollY > 24);\n  setNavState();\n  window.addEventListener('scroll', setNavState, { passive: true });\n\n  const revealItems = page.querySelectorAll('[data-reveal]');\n  if ('IntersectionObserver' in window) {\n    const revealObserver = new IntersectionObserver((entries, observer) => {\n      entries.forEach((entry) => {\n        if (entry.isIntersecting) {\n          entry.target.classList.add('is-visible');\n          observer.unobserve(entry.target);\n        }\n      });\n    }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });\n    revealItems.forEach((item) => revealObserver.observe(item));\n  } else {\n    revealItems.forEach((item) => item.classList.add('is-visible'));\n  }\n\n  const drawer = document.getElementById('reservation-drawer');\n  const scrim = document.getElementById('mora-scrim');\n  const drawerClose = document.getElementById('close-reservation');\n  const menu = document.getElementById('mobile-menu');\n  const menuButton = document.getElementById('mobile-menu-button');\n  const menuClose = document.getElementById('close-mobile-menu');\n  let lastFocus = null;\n\n  const syncLock = () => {\n    const locked = drawer.classList.contains('is-open') || menu.classList.contains('is-open') || !document.getElementById('gallery-lightbox').hasAttribute('hidden');\n    document.body.classList.toggle('mora-lock', locked);\n  };\n  const openDrawer = () => {\n    lastFocus = document.activeElement;\n    menu.classList.remove('is-open');\n    menu.setAttribute('aria-hidden', 'true');\n    menuButton.setAttribute('aria-expanded', 'false');\n    drawer.classList.add('is-open');\n    drawer.setAttribute('aria-hidden', 'false');\n    scrim.classList.add('is-open');\n    syncLock();\n    window.setTimeout(() => drawerClose.focus(), 360);\n  };\n  const closeDrawer = () => {\n    drawer.classList.remove('is-open');\n    drawer.setAttribute('aria-hidden', 'true');\n    scrim.classList.remove('is-open');\n    syncLock();\n    if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();\n  };\n  const openMenu = () => {\n    lastFocus = document.activeElement;\n    drawer.classList.remove('is-open');\n    drawer.setAttribute('aria-hidden', 'true');\n    scrim.classList.remove('is-open');\n    menu.classList.add('is-open');\n    menu.setAttribute('aria-hidden', 'false');\n    menuButton.setAttribute('aria-expanded', 'true');\n    syncLock();\n    window.setTimeout(() => menuClose.focus(), 360);\n  };\n  const closeMenu = () => {\n    menu.classList.remove('is-open');\n    menu.setAttribute('aria-hidden', 'true');\n    menuButton.setAttribute('aria-expanded', 'false');\n    syncLock();\n    if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();\n  };\n  page.querySelectorAll('[data-open-reservation]').forEach((button) => button.addEventListener('click', openDrawer));\n  drawerClose.addEventListener('click', closeDrawer);\n  scrim.addEventListener('click', closeDrawer);\n  menuButton.addEventListener('click', () => menu.classList.contains('is-open') ? closeMenu() : openMenu());\n  menuClose.addEventListener('click', closeMenu);\n  menu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));\n\n  const reservationForm = document.getElementById('reservation-form');\n  const reservationSubmit = document.getElementById('reservation-submit');\n  const reservationSubmitLabel = document.getElementById('reservation-submit-label');\n  const reservationStatus = document.getElementById('reservation-status');\n  const reservationAlt = document.getElementById('reservation-alt');\n  const reservationError = document.getElementById('reservation-error');\n  const loadingRule = document.getElementById('reservation-loading-rule');\n  reservationForm.addEventListener('submit', (event) => {\n    event.preventDefault();\n    if (!reservationForm.reportValidity()) return;\n    reservationSubmit.disabled = true;\n    reservationSubmitLabel.textContent = 'Checking availability';\n    loadingRule.classList.add('is-loading');\n    reservationStatus.textContent = 'Checking your preferred table time…';\n    reservationAlt.classList.add('hidden');\n    reservationError.classList.add('hidden');\n    window.setTimeout(() => {\n      reservationSubmit.disabled = false;\n      reservationSubmitLabel.textContent = 'Check availability';\n      loadingRule.classList.remove('is-loading');\n      const time = reservationForm.elements.time.value;\n      if (time === '20:30') {\n        reservationStatus.textContent = 'That first choice is not available just now.';\n        reservationAlt.classList.remove('hidden');\n      } else {\n        reservationStatus.textContent = 'Request received. We’ll confirm your table by phone or email.';\n      }\n    }, 850);\n  });\n\n  const foodData = [\n    { src: 'https://images.pexels.com/photos/14538480/pexels-photo-14538480.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80', alt: 'Hands sharing pizza and plates at a lively table, Doğu Tuncer on Pexels', name: 'Burrata & roasted tomatoes', meta: 'Olive oil · warm bread · antipasti' },\n    { src: 'https://images.unsplash.com/photo-1566802374089-a80446239c9d?auto=format&w=1200&q=80&fit=crop', alt: 'Handmade pasta twirled on a white ceramic plate with tomato and parmesan, Erwan Hesry on Unsplash', name: 'Truffle tagliatelle', meta: 'Warm parmesan · handmade pasta' },\n    { src: 'https://images.pexels.com/photos/33158334/pexels-photo-33158334.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80', alt: 'Fresh Italian pizza with blistered crust and basil, damla selen demir on Pexels', name: 'Blistered margherita', meta: 'Tomato · basil · shared hands' },\n    { src: 'https://images.unsplash.com/photo-1605851086486-2bfb45e926d9?auto=format&w=1200&q=80&fit=crop', alt: 'Italian grilled meat with roasted vegetables and red wine, sergey mikheev on Unsplash', name: 'Grilled beef', meta: 'Seasonal vegetables · red wine' },\n    { src: 'https://images.unsplash.com/photo-1661587781420-dc427db4ccda?auto=format&w=1000&q=80&fit=crop', alt: 'Dessert and shared plates being prepared at a restaurant table, Filipp Romanovski on Unsplash', name: 'Tiramisù', meta: 'Espresso · mascarpone · to share' }\n  ];\n  const foodRows = page.querySelectorAll('[data-food-index]');\n  const foodImage = document.getElementById('food-image');\n  const foodName = document.getElementById('food-dish-name');\n  const foodMeta = document.getElementById('food-dish-meta');\n  let foodTimer;\n  const updateFood = (index) => {\n    const item = foodData[index];\n    foodRows.forEach((row) => {\n      const active = Number(row.dataset.foodIndex) === index;\n      row.classList.toggle('is-active', active);\n      row.setAttribute('aria-selected', String(active));\n      row.querySelector('.mora-food-rule').classList.toggle('w-8', active);\n      row.querySelector('.mora-food-rule').classList.toggle('w-0', !active);\n    });\n    foodImage.classList.add('mora-image-changing');\n    window.clearTimeout(foodTimer);\n    foodTimer = window.setTimeout(() => {\n      foodImage.src = item.src;\n      foodImage.alt = item.alt;\n      foodName.textContent = item.name;\n      foodMeta.textContent = item.meta;\n      foodImage.classList.remove('mora-image-changing');\n    }, 120);\n  };\n  foodRows.forEach((row) => {\n    row.addEventListener('click', () => updateFood(Number(row.dataset.foodIndex)));\n    row.addEventListener('keydown', (event) => {\n      if (event.key === 'ArrowDown' || event.key === 'ArrowRight') { event.preventDefault(); const next = (Number(row.dataset.foodIndex) + 1) % foodData.length; foodRows[next].focus(); updateFood(next); }\n      if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') { event.preventDefault(); const next = (Number(row.dataset.foodIndex) - 1 + foodData.length) % foodData.length; foodRows[next].focus(); updateFood(next); }\n    });\n  });\n\n  const occasionData = [\n    { src: 'https://images.pexels.com/photos/17086329/pexels-photo-17086329.jpeg?auto=compress&cs=tinysrgb&w=1100&q=80', alt: 'Warm contemporary restaurant interior with olive seating and evening lamps, SAAD EMRIS on Pexels', caption: 'Lunch at CHOUSE · easy plates, second espresso', copy: 'A quick plate if you need it; a second espresso if you don’t.' },\n    { src: 'https://images.pexels.com/photos/39215054/pexels-photo-39215054.jpeg?auto=compress&cs=tinysrgb&w=1100&q=80', alt: 'Bright aperitivo cocktail catching warm evening light, Nati on Pexels', caption: 'Aperitivo · bitter orange, small plates', copy: 'Aperol, bitter orange, small plates and an unhurried start.' },\n    { src: 'https://images.pexels.com/photos/30044364/pexels-photo-30044364.jpeg?auto=compress&cs=tinysrgb&w=1100&q=80', alt: 'Friends clinking wine glasses over dinner, Jeremy Li on Pexels', caption: 'Dinner at CHOUSE · bottles made for passing around', copy: 'Pasta, proper mains and bottles made for passing around.' },\n    { src: 'https://images.pexels.com/photos/2072569/pexels-photo-2072569.jpeg?auto=compress&cs=tinysrgb&w=1100&q=80', alt: 'Couple sharing a warm dinner at an Italian restaurant, Elina Sazonova on Pexels', caption: 'Date night · low light, one corner table', copy: 'Low light, a corner table and dessert worth sharing.' },\n    { src: 'https://images.pexels.com/photos/5086623/pexels-photo-5086623.jpeg?auto=compress&cs=tinysrgb&w=1100&q=80', alt: 'Friends enjoying an animated dinner together, Jep Gambardella on Pexels', caption: 'Friends · one more round for the table', copy: 'Big tables, louder stories, one more round.' },\n    { src: 'https://images.pexels.com/photos/37307299/pexels-photo-37307299.jpeg?auto=compress&cs=tinysrgb&w=1100&q=80', alt: 'Lively group gathered around a warmly lit dinner table, Le Salama on Pexels', caption: 'Private celebrations · room to linger', copy: 'Dinner parties, birthdays and gatherings with room to linger.' }\n  ];\n  const occasionRows = page.querySelectorAll('[data-occasion-index]');\n  const occasionImage = document.getElementById('occasion-image');\n  const occasionCaption = document.getElementById('occasion-caption');\n  const occasionCopy = document.getElementById('occasion-copy');\n  let occasionTimer;\n  const updateOccasion = (index) => {\n    const item = occasionData[index];\n    occasionRows.forEach((row) => {\n      const active = Number(row.dataset.occasionIndex) === index;\n      row.classList.toggle('is-active', active);\n      row.setAttribute('aria-selected', String(active));\n    });\n    occasionImage.classList.add('mora-image-changing');\n    window.clearTimeout(occasionTimer);\n    occasionTimer = window.setTimeout(() => {\n      occasionImage.src = item.src;\n      occasionImage.alt = item.alt;\n      occasionCaption.textContent = item.caption;\n      occasionCopy.textContent = item.copy;\n      occasionImage.classList.remove('mora-image-changing');\n    }, 140);\n  };\n  occasionRows.forEach((row) => {\n    row.addEventListener('click', () => updateOccasion(Number(row.dataset.occasionIndex)));\n    row.addEventListener('keydown', (event) => {\n      if (event.key === 'ArrowDown' || event.key === 'ArrowRight') { event.preventDefault(); const next = (Number(row.dataset.occasionIndex) + 1) % occasionData.length; occasionRows[next].focus(); updateOccasion(next); }\n      if (event.key === 'ArrowUp' || event.key === 'ArrowLeft') { event.preventDefault(); const next = (Number(row.dataset.occasionIndex) - 1 + occasionData.length) % occasionData.length; occasionRows[next].focus(); updateOccasion(next); }\n    });\n  });\n\n  const galleryData = [\n    { src: 'https://images.pexels.com/photos/17086329/pexels-photo-17086329.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80', alt: 'Warm contemporary restaurant interior with olive seating and evening lamps, SAAD EMRIS on Pexels', caption: '19:42 · second round' },\n    { src: 'https://images.pexels.com/photos/30044364/pexels-photo-30044364.jpeg?auto=compress&cs=tinysrgb&w=1000&q=80', alt: 'Friends clinking wine glasses over dinner, Jeremy Li on Pexels', caption: '21:07 · glasses raised' },\n    { src: 'https://images.pexels.com/photos/14538480/pexels-photo-14538480.jpeg?auto=compress&cs=tinysrgb&w=900&q=80', alt: 'Hands sharing pizza and plates at a lively table, Doğu Tuncer on Pexels', caption: '12:18 · lunch table' },\n    { src: 'https://images.pexels.com/photos/39215054/pexels-photo-39215054.jpeg?auto=compress&cs=tinysrgb&w=1000&q=80', alt: 'Bright aperitivo cocktail catching warm evening light, Nati on Pexels', caption: '18:36 · first pour' },\n    { src: 'https://images.pexels.com/photos/26729397/pexels-photo-26729397.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80', alt: 'Long, warmly lit restaurant interior with tables and amber light, Quang Nguyen Vinh on Pexels', caption: '20:14 · corner table' },\n    { src: 'https://images.pexels.com/photos/28871009/pexels-photo-28871009.jpeg?auto=compress&cs=tinysrgb&w=1000&q=80', alt: 'People sharing Italian dishes across a candlelit table, Gül Işık on Pexels', caption: '21:07 · pasta, passed around' },\n    { src: 'https://images.unsplash.com/photo-1661587781420-dc427db4ccda?auto=format&w=900&q=80&fit=crop', alt: 'Shared antipasti and linen details on a restaurant table, Filipp Romanovski on Unsplash', caption: '19:04 · the little details' }\n  ];\n  const lightbox = document.getElementById('gallery-lightbox');\n  const lightboxImage = document.getElementById('lightbox-image');\n  const lightboxCaption = document.getElementById('lightbox-caption');\n  const lightboxCount = document.getElementById('lightbox-count');\n  const lightboxClose = document.getElementById('lightbox-close');\n  let galleryIndex = 0;\n  const paintGallery = () => {\n    const item = galleryData[galleryIndex];\n    lightboxImage.src = item.src;\n    lightboxImage.alt = item.alt;\n    lightboxCaption.textContent = item.caption;\n    lightboxCount.textContent = String(galleryIndex + 1).padStart(2, '0') + ' / ' + String(galleryData.length).padStart(2, '0');\n  };\n  const openGallery = (index) => {\n    lastFocus = document.activeElement;\n    galleryIndex = index;\n    paintGallery();\n    lightbox.removeAttribute('hidden');\n    lightbox.setAttribute('aria-hidden', 'false');\n    syncLock();\n    window.setTimeout(() => lightboxClose.focus(), 20);\n  };\n  const closeGallery = () => {\n    lightbox.setAttribute('aria-hidden', 'true');\n    lightbox.setAttribute('hidden', '');\n    syncLock();\n    if (lastFocus && typeof lastFocus.focus === 'function') lastFocus.focus();\n  };\n  page.querySelectorAll('[data-gallery-index]').forEach((button) => button.addEventListener('click', () => openGallery(Number(button.dataset.galleryIndex))));\n  document.getElementById('lightbox-prev').addEventListener('click', () => { galleryIndex = (galleryIndex - 1 + galleryData.length) % galleryData.length; paintGallery(); });\n  document.getElementById('lightbox-next').addEventListener('click', () => { galleryIndex = (galleryIndex + 1) % galleryData.length; paintGallery(); });\n  lightboxClose.addEventListener('click', closeGallery);\n  lightbox.addEventListener('click', (event) => { if (event.target === lightbox) closeGallery(); });\n\n  const reserveDock = document.getElementById('reserve-dock');\n  const heroReserve = document.getElementById('hero-reserve');\n  if ('IntersectionObserver' in window && heroReserve) {\n    const dockObserver = new IntersectionObserver(([entry]) => {\n      const shouldShow = !entry.isIntersecting && entry.boundingClientRect.top < 0;\n      reserveDock.classList.toggle('is-visible', shouldShow);\n      reserveDock.setAttribute('aria-hidden', String(!shouldShow));\n    }, { threshold: 0 });\n    dockObserver.observe(heroReserve);\n  }\n\n  document.addEventListener('keydown', (event) => {\n    if (event.key === 'Escape') {\n      if (!lightbox.hasAttribute('hidden')) closeGallery();\n      else if (drawer.classList.contains('is-open')) closeDrawer();\n      else if (menu.classList.contains('is-open')) closeMenu();\n    }\n  });\n})();\n</script>\n",
